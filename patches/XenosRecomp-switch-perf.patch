+            Type type;
+            uint32_t width;
+            if (Peek().kind == Token::Kind::IDENTIFIER && typeName(Peek().text, type, width) &&
+                Peek(1).kind == Token::Kind::IDENTIFIER && Is("=", 2))
+            {
+                auto statement = std::make_unique<Statement>();
+                statement->kind = Statement::Kind::DECLARE;
+                statement->type = Peek().text;
+                statement->name = Peek(1).text;
+                position += 3;
+                statement->expression = ParseExpression();
