+    // What DXC compiles for SPIR-V (__spirv__ defined, __air__ not): the lines of [begin, end) outside inactive
+    // #ifdef / #ifndef / #else parts, without the directives. Any other directive is not understood.
+    std::vector<std::string> spirvView(const std::vector<std::string>& source, size_t begin, size_t end)
+    {
+        std::vector<std::string> result;
+        std::vector<std::pair<bool, bool>> stack; // (active, condition)
+        auto active = [&]() { return stack.empty() || stack.back().first; };
+
+        for (size_t i = begin; i < end; i++)
+        {
+            const std::string text = trim(source[i]);
+            if (!text.empty() && text[0] == '#')
+            {
+                if (text.rfind("#ifdef ", 0) == 0 || text.rfind("#ifndef ", 0) == 0)
+                {
+                    const bool negated = text[3] == 'n';
+                    const std::string name = trim(text.substr(negated ? 8 : 7));
+                    const bool condition = (name == "__spirv__") != negated;
+                    const bool parent = active();
+                    stack.emplace_back(parent && condition, condition);
+                }
+                else if (text == "#else")
+                {
+                    if (stack.empty())
+                        unsupported("#else without #if");
+                    const bool parent = stack.size() < 2 || stack[stack.size() - 2].first;
+                    stack.back().first = parent && !stack.back().second;
+                }
+                else if (text == "#endif")
