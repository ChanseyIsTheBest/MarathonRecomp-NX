+    enum class Type : uint8_t
+    {
+        FLOAT,
+        INT,
+        UINT,
+        BOOL,
+        UNKNOWN,
+    };
+
+    // float, float2... int, uint, bool: the scalar type and the component count.
+    bool typeName(const std::string& name, Type& type, uint32_t& width)
+    {
+        static const std::regex TYPE(R"(^(float|int|uint|bool)([1-4]?)$)");
+        std::smatch match;
+        if (!std::regex_match(name, match, TYPE))
+            return false;
+
+        const std::string base = match[1].str();
+        type = base == "float" ? Type::FLOAT : base == "int" ? Type::INT : base == "uint" ? Type::UINT : Type::BOOL;
+        width = match[2].length() != 0 ? uint32_t(std::stoul(match[2].str())) : 1;
+        return true;
+    }
+
+    struct Expression
+    {
+        enum class Kind { NUMBER, IDENTIFIER, CALL, MEMBER, UNARY, BINARY, TERNARY, CAST };
+
+        Kind kind;
+        std::string text; // the number, name, function, member, operator or type
+        std::vector<std::unique_ptr<Expression>> operands;
+    };
+
+    struct Statement
+    {
+        enum class Kind { BLOCK, IF, ASSIGN, DECLARE };
+
+        Kind kind;
+        std::vector<std::unique_ptr<Statement>> statements; // BLOCK; IF: then [, else]
+        std::unique_ptr<Expression> expression;             // IF: condition; ASSIGN, DECLARE: value
+        std::vector<std::string> condition;                 // IF: the condition's tokens
+        std::string name;                                   // ASSIGN, DECLARE
+        std::string mask;                                   // ASSIGN
+        std::string op;                                     // ASSIGN: =, +=...
+        std::string type;                                   // DECLARE
+    };
+
+    // Statements (blocks, if/else with [attributes] or the BRANCH macro, assignments, declarations) and expressions
+    // (C precedence, casts, calls, swizzles). Anything else is not understood.
+    class Parser
+    {
+    public:
+        explicit Parser(std::vector<Token> tokens) : tokens(std::move(tokens))
+        {
+        }
+
+        std::unique_ptr<Statement> ParseBlockContents()
+        {
+            auto block = std::make_unique<Statement>();
+            block->kind = Statement::Kind::BLOCK;
+            while (Peek().kind != Token::Kind::END)
+                block->statements.push_back(ParseStatement());
+            return block;
+        }
+
+    private:
+        std::vector<Token> tokens;
+        size_t position = 0;
+
+        const Token& Peek(size_t ahead = 0) const
+        {
+            return tokens[std::min(position + ahead, tokens.size() - 1)];
+        }
+
+        bool Is(std::string_view text, size_t ahead = 0) const
+        {
+            const Token& token = Peek(ahead);
+            return token.kind != Token::Kind::END && token.kind != Token::Kind::NUMBER && token.text == text;
+        }
+
+        void Expect(std::string_view text)
