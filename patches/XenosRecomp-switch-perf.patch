diff --git a/XenosRecomp/shader_common.h b/XenosRecomp/shader_common.h
index 5e0b6b1..6f85593 100644
--- a/XenosRecomp/shader_common.h
+++ b/XenosRecomp/shader_common.h
@@ -14,6 +14,196 @@
     #define SPEC_CONSTANT_CONDITIONAL_RENDERING (1 << 5)
 #endif
 
+// Switch performance bits (g_SpecConstants, specialization constant 0). The numbers are the ones of
+// UnleashedRecomp-NX, so that its translator and renderer code keep them. Marathon's renderer ORs its
+// own ALPHA_TO_COVERAGE (3) and REVERSE_Z (4) into the pipeline state before masking, so no bit a
+// shader can carry in its mask may ever be 3 or 4; 2 is left free.
+//   0 R11G11B10_NORMAL, 1 ALPHA_TEST, 5 CONDITIONAL_RENDERING: per-shader mask (above)
+//   6 NO_CLIP_DISTANCE: renderer, per pipeline, after masking (Marathon only)
+//   7 SURVEY_SLOTS: renderer, every pipeline, after masking (Marathon only)
+//   8 CONSTANTS_UBO, 9/10 TEXTURE_SIZE(_VERIFY), 11/12 SHADOW_GATHER(_VERIFY): renderer, after masking
+//   13 RELATIVE_FROM_MEMORY: renderer, after masking, for vertex shaders with SHADER_FLAG_RELATIVE_CONSTANTS (A/B)
+//   14/15: Unleashed's BONES_SPECIALIZED/HAS_BONES, reserved (Sonic '06 has no vertex booleans)
+//   16-19 UNUSED_COLOR_SHIFT: renderer, per pipeline, after masking
+//   20 ALPHA_TEST_EARLY_OUT, 22 ALPHA_TEST_SINK: pixel shader mask (renderer, before masking)
+//   21 SHADOW_GATHER_KNOWN: renderer, per pipeline, after masking
+//   23/24 BLEND_SKIP_ALPHA/ZERO: every pixel shader's mask (renderer, per pipeline, before masking)
+//   25: Unleashed's ALPHA_TEST_QUAD_SINK, reserved (not ported)
+// Specialization constants 1-3 (g_SpecUnusedOutputs0-2) hold the unused vertex outputs, 4 (g_SpecVertexSwaps)
+// the vertex attribute swaps (Marathon only).
+
+// Shared constants past the 320 bytes of the renderer's original SharedConstants (byte offsets). The
+// renderer's struct must be SHARED_CONSTANTS_SIZE bytes with these at the same offsets, and set 5 binding 2
+// must bind all of it. Only translated shaders that read one of them declare the whole block
+// (UR_SHARED_CONSTANTS_TABLES, defined by the translator before this header).
+//   320 + 16 * s: float4 per slot s: width, height and layer count of the Texture2DArray view behind the
+//                 slot's texture2DArrayIndices descriptor, as GetDimensions(0, ...) returns them (a plain 2D
+//                 texture there: (w, h, 1); the null array: (1, 1, 1)); w unused. SPEC_CONSTANT_TEXTURE_SIZE.
+//   576:          uint g_GatherableSlots, bit s: see SPEC_CONSTANT_SHADOW_GATHER. 580-591 unused.
+//   592 + 8 * s:  float2 per slot s: width and height of mip 0 of the Texture2D behind the slot's
+//                 texture2DIndices descriptor. SPEC_CONSTANT_TEXTURE_SIZE; read only by 2D fetches with an
+//                 offset and by 2D weights, which no Sonic '06 shader has today.
+#define SHARED_CONSTANTS_TEXTURE_2D_ARRAY_SIZES_OFFSET  320
+#define SHARED_CONSTANTS_GATHERABLE_SLOTS_OFFSET        576
+#define SHARED_CONSTANTS_TEXTURE_2D_SIZES_OFFSET        592
+#define SHARED_CONSTANTS_SIZE                           720
+
+// Vulkan only: read the shader constants from dynamic uniform buffers (set 5, bindings 0/1/2)
+// instead of through 64-bit pointers. NVK promotes dynamic UBOs to hardware constant banks, also
+// on Maxwell; the pointer path compiles to global memory loads. Set 4 is the conditional survey
+// buffer. The renderer ORs this bit into every pipeline after masking (it is intentionally not part
+// of any shader's specConstantsMask, so D3D12, Metal and the DXIL generation are unaffected).
+#define SPEC_CONSTANT_CONSTANTS_UBO     (1 << 8)
+
+// Vulkan only, ORed in by the renderer after masking, like the UBO bit: texture sizes from the shared
+// constants instead of GetDimensions() queries. Every Texture2DArray fetch and weight needs the size (the
+// layer is texCoord.z * layers), 2D fetches only with an offset. The renderer writes, per slot, the size of
+// the view behind the bound descriptor (all views start at mip 0 and layer 0 and have every layer), which
+// is what GetDimensions() returns; the arithmetic that uses it is unchanged (the same uint to float
+// conversion, then the same division or multiplication), so the results are bit-identical. With the
+// VERIFY bit the sizes still come from the queries, and a pixel shader any of whose sizes differs from its
+// constant outputs magenta (before the alpha test), to validate the renderer's tables on the console.
+#define SPEC_CONSTANT_TEXTURE_SIZE          (1 << 9)
+#define SPEC_CONSTANT_TEXTURE_SIZE_VERIFY   (1 << 10)
+
+// Vulkan only: specialization constants 1-3 (g_SpecUnusedOutputs0-2) hold, per pipeline, one bit per
+// vertex shader output component that nothing reads: bit 4 * k + c of the 72, spread over the three
+// 32-bit constants, is component c (x, y, z, w) of interpolator k in the translator's order
+// (TEXCOORD0-15, then COLOR0-1, which is also their location in both stages). Either the pipeline's
+// pixel shader never reads that component or the pipeline has no pixel shader. The vertex shader then
+// writes 0 to it at every exit, so the driver's compiler drops the math and the vertex fetches that
+// only fed it; the image cannot change, since nothing reads it. Set by the renderer per pipeline.
+#define SPEC_CONSTANT_UNUSED_OUTPUT_COMPONENT_COUNT 72
+
+// Vulkan only, ORed into every pipeline by the renderer after masking, like the UBO bit: the shadow map
+// filter (four point fetches of a Texture2DArray at (+-0.5, +-0.5) texels of one coordinate: the cascaded
+// shadow maps) read with one gather wherever that returns the very same texels. The slot must be in
+// g_GatherableSlots, which the renderer sets for a view with power-of-two width and height and one mip level,
+// sampled with point filtering both ways, without anisotropy or depth comparison; the pixel's coordinate must
+// be in [0.5 / size, 1] (tfetch2DArrayGatherExact). Otherwise the point fetches run. VERIFY does both and draws
+// magenta where they differ.
+#define SPEC_CONSTANT_SHADOW_GATHER         (1 << 11)
+#define SPEC_CONSTANT_SHADOW_GATHER_VERIFY  (1 << 12)
+
+// Vulkan only, ORed in by the renderer after masking for the vertex shaders with SHADER_FLAG_RELATIVE_CONSTANTS
+// (in no mask, so that D3D12's linking and the DXIL stay as they are; A/B): constant arrays indexed by a0 (bone
+// palettes), whose index differs from one vertex to the next, read through the constant pointer (L1 cache)
+// instead of the constant bank, which serializes different addresses within a warp. The same bytes of the same
+// upload allocation either way (the UBO and the pointer address one block), so the same value for every index
+// the block holds. Such a pipeline reads those arrays through the pointer: the renderer must push it.
+#define SPEC_CONSTANT_RELATIVE_FROM_MEMORY  (1 << 13)
+
+// Vulkan only, ORed in by the renderer after masking, per pipeline, only into pipelines that are drawn with the
+// clip plane disabled (g_ClipPlaneEnabled false at every draw; the clip plane state must then select the
+// pipeline). Such a pipeline's vertex shader does not write SV_ClipDistance (SHADER_FLAG_CLIP_DISTANCE_SPECIALIZED:
+// the translator makes that store depend on this bit in the SPIR-V). With the plane disabled every vertex wrote
+// +0.0, and a primitive whose clip distances are all >= 0 is not clipped at all, so the primitives were those of
+// no clip distance. Without the write the driver finds no clip distance output (Mesa's nir_shader_gather_info
+// clears clip_distance_array_size, NAK leaves the user clip plane off): no clip test and one output fewer per
+// vertex, the same primitives. Only for a driver that does that (NVK); never for a pipeline drawn with the plane
+// enabled.
+#define SPEC_CONSTANT_NO_CLIP_DISTANCE      (1 << 6)
+
+// Vulkan only, ORed into every pipeline by the renderer after masking while it runs the conditional surveys with
+// slots and generations instead of counters it zeroes before each survey. g_conditionalSurveySlot (the word of
+// g_conditionalSurveyIndex, byte 312) then holds the slot of g_ConditionalSurveyBuffer that the latest survey of
+// the current survey index writes, and g_conditionalSurveyGeneration (the word of g_conditionalRenderingIndex,
+// byte 316, which no shader reads otherwise) that survey's generation, a value no earlier survey stored in that
+// slot. Its survey pixel shader stores the generation instead of counting, and the conditional rendering
+// prologue discards where the slot does not hold the generation, instead of where the count is 0: both mean that
+// none of that survey's samples has written. Without the bit, the count is tested against 0 as before.
+#define SPEC_CONSTANT_SURVEY_SLOTS          (1 << 7)
+
+// Vulkan only: specialization constant 4 (g_SpecVertexSwaps), set by the renderer per pipeline from the pipeline's
+// vertex declaration (part of the pipeline key, so it adds no pipeline): VERTEX_SWAPS_SPECIALIZED plus the
+// declaration's five half-swap masks (swappedTexcoords..., which the renderer also puts in the shared constants,
+// ProcSetVertexDeclaration), 4 bits each at these shifts (a vertex shader reads usage indices 0-3 at most). The
+// vertex shader then takes them from the constant instead of the shared constants: swapFloats() gets the same
+// mask as a constant, so the driver resolves each swap (a pure component permutation, no arithmetic) when it
+// compiles the pipeline, and the attribute reaches the same instructions with the same bits. 0 (left out): the
+// shared constants, as before.
+#define VERTEX_SWAPS_SPECIALIZED            (1u << 31)
+#define VERTEX_SWAPS_TEXCOORDS_SHIFT        0
+#define VERTEX_SWAPS_NORMALS_SHIFT          4
+#define VERTEX_SWAPS_BINORMALS_SHIFT        8
+#define VERTEX_SWAPS_TANGENTS_SHIFT         12
+#define VERTEX_SWAPS_BLEND_WEIGHTS_SHIFT    16
+
+// Vulkan only, set by the renderer per pipeline: bit (SHIFT + c) means component c of oC0 is neither
+// written (colour write mask, no target) nor used by blending, the alpha test or alpha to coverage.
+// The pixel shader writes 0 to it at every exit, so its math is dropped.
+#define SPEC_CONSTANT_UNUSED_COLOR_SHIFT    16
+
+// Pixel shaders, part of their mask when the translator wrote the early-out; ORed into every pipeline by
+// the renderer before masking (Vulkan only). With the alpha test on, the arithmetic between the last write
+// of oC0.w and the alpha test (which has no texture fetch and no derivative in it) only runs for pixels the
+// alpha test keeps: the others skip it and are discarded, as before. Kept pixels run exactly the same code.
+#define SPEC_CONSTANT_ALPHA_TEST_EARLY_OUT  (1 << 20)
+
+// Vulkan only, set by the renderer per pipeline (after masking, like SPEC_CONSTANT_SHADOW_GATHER): every
+// slot the pixel shader's gather rewrites read (its cache entry's gatherSlots) is known to hold a gatherable
+// texture and sampler for this draw, so the runtime check of g_GatherableSlots is compiled out (the point
+// fetches stay, for pixels outside tfetch2DArrayGatherExact's range). The renderer re-selects the pipeline
+// whenever g_GatherableSlots changes.
+#define SPEC_CONSTANT_SHADOW_GATHER_KNOWN   (1 << 21)
+
+// Pixel shaders, part of their mask when the translator wrote a sunk variant (with
+// SPEC_CONSTANT_ALPHA_TEST_EARLY_OUT); ORed in by the renderer before masking (Vulkan only). Such a shader holds
+// two copies of its code, chosen by UR_ALPHA_TEST_SINK: the previous code, and a variant in which everything
+// that does not feed the alpha runs inside the early-out, so the pixels the alpha test (or the blend skip)
+// discards skip it too; never a texture fetch with an implicit level of detail or a derivative, which stay
+// before the branch. Kept pixels compute the same values (the translator proves every variant equivalent to the
+// previous code, sink_check.h). The variant runs only while the early-out can skip pixels and no verification
+// bit is set; otherwise, and on the other backends, the previous code runs unchanged.
+#define SPEC_CONSTANT_ALPHA_TEST_SINK       (1 << 22)
