+                static constexpr std::string_view ASSIGNMENTS[] = { "=", "+=", "-=", "*=", "/=" };
+                for (auto op : ASSIGNMENTS)
+                {
+                    if (Is(op))
+                    {
+                        statement->op = std::string(op);
+                        position++;
+                        statement->expression = ParseExpression();
+                        Expect(";");
+                        return statement;
+                    }
+                }
+            }
+
+            unsupported(fmt::format("statement at '{}'", Peek().text));
+        }
+
+        std::unique_ptr<Expression> Make(Expression::Kind kind, std::string text)
+        {
+            auto expression = std::make_unique<Expression>();
+            expression->kind = kind;
+            expression->text = std::move(text);
+            return expression;
+        }
+
+        std::unique_ptr<Expression> ParseExpression()
+        {
+            auto condition = ParseBinary(0);
+            if (!Is("?"))
+                return condition;
+
+            position++;
+            auto whenTrue = ParseExpression();
+            Expect(":");
+            auto whenFalse = ParseExpression();
+
+            auto expression = Make(Expression::Kind::TERNARY, "?:");
+            expression->operands.push_back(std::move(condition));
+            expression->operands.push_back(std::move(whenTrue));
+            expression->operands.push_back(std::move(whenFalse));
+            return expression;
+        }
+
+        std::unique_ptr<Expression> ParseBinary(size_t level)
+        {
+            static const std::vector<std::vector<std::string_view>> LEVELS =
+            {
+                { "||" }, { "&&" }, { "|" }, { "^" }, { "&" }, { "==", "!=" }, { "<", ">", "<=", ">=" }, { "<<", ">>" },
+                { "+", "-" }, { "*", "/", "%" },
+            };
+
+            if (level == LEVELS.size())
+                return ParseUnary();
+
+            auto left = ParseBinary(level + 1);
+            while (true)
+            {
+                bool found = false;
+                for (auto op : LEVELS[level])
+                {
+                    if (Is(op))
+                    {
+                        position++;
+                        auto expression = Make(Expression::Kind::BINARY, std::string(op));
+                        expression->operands.push_back(std::move(left));
+                        expression->operands.push_back(ParseBinary(level + 1));
+                        left = std::move(expression);
+                        found = true;
+                        break;
+                    }
+                }
+                if (!found)
+                    return left;
+            }
+        }
+
+        std::unique_ptr<Expression> ParseUnary()
+        {
+            for (std::string_view op : { "-", "+", "!", "~" })
+            {
+                if (Is(op))
+                {
+                    position++;
+                    auto expression = Make(Expression::Kind::UNARY, std::string(op));
+                    expression->operands.push_back(ParseUnary());
+                    return expression;
+                }
+            }
+
+            Type type;
+            uint32_t width;
+            if (Is("(") && Peek(1).kind == Token::Kind::IDENTIFIER && typeName(Peek(1).text, type, width) && Is(")", 2))
+            {
+                auto expression = Make(Expression::Kind::CAST, Peek(1).text);
+                position += 3;
+                expression->operands.push_back(ParseUnary());
+                return expression;
+            }
+
+            return ParsePostfix(ParsePrimary());
+        }
+
+        std::unique_ptr<Expression> ParsePrimary()
+        {
+            const Token& token = Peek();
+            if (token.kind == Token::Kind::NUMBER)
+            {
+                position++;
+                return Make(Expression::Kind::NUMBER, token.text);
+            }
+
+            if (token.kind == Token::Kind::IDENTIFIER)
+            {
+                const std::string name = token.text;
+                position++;
+                if (!Is("("))
+                    return Make(Expression::Kind::IDENTIFIER, name);
+
+                position++;
+                auto call = Make(Expression::Kind::CALL, name);
+                if (!Is(")"))
+                {
+                    while (true)
+                    {
+                        call->operands.push_back(ParseExpression());
+                        if (Is(")"))
+                            break;
+                        Expect(",");
+                    }
+                }
+                position++;
+                return call;
+            }
+
+            if (Is("("))
+            {
+                position++;
+                auto inner = ParseExpression();
+                Expect(")");
+                return inner;
+            }
+
+            unsupported(fmt::format("expression at '{}'", token.text));
+        }
+
+        std::unique_ptr<Expression> ParsePostfix(std::unique_ptr<Expression> expression)
+        {
+            while (true)
+            {
+                if (Is("."))
+                {
+                    position++;
+                    if (Peek().kind != Token::Kind::IDENTIFIER)
+                        unsupported("member");
+                    auto member = Make(Expression::Kind::MEMBER, Peek().text);
+                    position++;
+                    member->operands.push_back(std::move(expression));
+                    expression = std::move(member);
+                    continue;
+                }
+                if (Is("[") || Is("++") || Is("--"))
+                    unsupported("subscript or increment");
+                return expression;
+            }
+        }
+    };
+
+    // Values as terms: a node per operation with its operand terms (and result type), shared, so that equal terms
+    // are equal computations: the same operations on the same values in the same order. Selects are normalised
+    // with identities that hold for every value (a select on !c is a select on c with its sides swapped; under c a
+    // select on c takes its true side, outside it its false side; both sides equal: that side).
+    class Terms
+    {
+    public:
+        uint32_t Make(const std::string& op, std::vector<uint32_t> operands, Type type)
+        {
+            auto key = std::make_tuple(op, operands, type);
+            auto found = index.find(key);
+            if (found != index.end())
+                return found->second;
+
+            const uint32_t id = uint32_t(nodes.size());
+            nodes.push_back({ op, std::move(operands), type });
+            index.emplace(std::move(key), id);
+            return id;
+        }
+
+        Type TypeOf(uint32_t id) const
+        {
+            return nodes[id].type;
+        }
+
+        const std::string& Op(uint32_t id) const
+        {
+            return nodes[id].op;
+        }
+
+        uint32_t Convert(uint32_t id, Type type)
+        {
+            return TypeOf(id) == type ? id : Make("convert", { id }, type);
+        }
+
+        uint32_t Not(uint32_t condition)
+        {
+            condition = Convert(condition, Type::BOOL);
+            if (Op(condition) == "!")
+                return nodes[condition].operands[0];
+            return Make("!", { condition }, Type::BOOL);
+        }
+
+        uint32_t Select(uint32_t condition, uint32_t whenTrue, uint32_t whenFalse)
+        {
+            if (Op(condition) == "!")
+            {
+                std::swap(whenTrue, whenFalse);
+                condition = nodes[condition].operands[0];
+            }
+            while (Op(whenTrue) == "select" && nodes[whenTrue].operands[0] == condition)
+                whenTrue = nodes[whenTrue].operands[1];
+            while (Op(whenFalse) == "select" && nodes[whenFalse].operands[0] == condition)
+                whenFalse = nodes[whenFalse].operands[2];
+            if (whenTrue == whenFalse)
+                return whenTrue;
+            if (TypeOf(whenTrue) != TypeOf(whenFalse))
+                unsupported("select of two types");
+            return Make("select", { condition, whenTrue, whenFalse }, TypeOf(whenTrue));
+        }
+
+        // A readable form of a term, for the messages.
+        std::string Describe(uint32_t id, int depth = 3) const
+        {
+            const Node& node = nodes[id];
+            if (node.operands.empty())
+                return node.op;
+            if (depth == 0)
+                return node.op + "(...)";
+            std::string result = node.op + "(";
+            for (size_t i = 0; i < node.operands.size(); i++)
+                result += (i != 0 ? ", " : "") + Describe(node.operands[i], depth - 1);
+            return result + ")";
+        }
+
+    private:
+        struct Node
+        {
+            std::string op;
+            std::vector<uint32_t> operands;
+            Type type;
+        };
+
+        std::vector<Node> nodes;
+        std::map<std::tuple<std::string, std::vector<uint32_t>, Type>, uint32_t> index;
+    };
+
+    using Value = std::vector<uint32_t>;
+
+    struct Variable
+    {
+        Type type;
+        Value components;
+    };
+
+    // What both texts share: main's variables (and the outputs) with their values at the start of the body, and
+    // the constants' types.
+    struct Context
+    {
+        std::map<std::string, Variable> variables;
+        std::set<std::string> outputs;
+        std::map<std::string, std::pair<Type, uint32_t>> constants;
+        std::vector<std::string> earlyOutCondition;
+        std::vector<std::string> gatherVerifyCondition;
+    };
+
+    // Runs a body symbolically. earlyOutTaken: the pixel runs the early-out branch (it is kept), or skips it (the
+    // alpha test or the blend skip discards it).
+    class Evaluator
+    {
+    public:
+        std::map<std::string, Variable> variables;
+        std::vector<uint32_t> earlyOutAlphas;
+        size_t earlyOuts = 0;
+        bool topLevelDeclarations = false;
+        // Fetches with an implicit level of detail and derivatives: (call, conditions it runs under).
+        std::vector<std::pair<uint32_t, uint32_t>> implicitLod;
+
+        Evaluator(Terms& terms, const Context& context, bool earlyOutTaken)
+            : terms(terms), context(context), earlyOutTaken(earlyOutTaken)
+        {
+        }
+
+        void Run(const Statement& body)
+        {
+            variables = context.variables;
+            for (auto& statement : body.statements)
+            {
+                if (statement->kind == Statement::Kind::DECLARE)
+                    topLevelDeclarations = true;
+            }
+            Execute(body);
+        }
+
+        uint32_t Alpha() const
+        {
+            auto found = variables.find("oC0");
+            if (found == variables.end() || found->second.components.size() != 4)
+                unsupported("no oC0");
+            return found->second.components[3];
+        }
+
+    private:
+        Terms& terms;
+        const Context& context;
+        const bool earlyOutTaken;
+        uint32_t earlyOutDepth = 0;
+        std::vector<uint32_t> path;
+        std::vector<std::vector<std::string>> scopes;
+
+        void Execute(const Statement& statement)
+        {
+            switch (statement.kind)
+            {
+            case Statement::Kind::BLOCK:
+                scopes.emplace_back();
+                for (auto& child : statement.statements)
+                    Execute(*child);
+                for (auto& name : scopes.back())
+                    variables.erase(name);
+                scopes.pop_back();
+                break;
+
+            case Statement::Kind::DECLARE:
+                Declare(statement);
+                break;
+
+            case Statement::Kind::ASSIGN:
+                Assign(statement);
+                break;
+
+            case Statement::Kind::IF:
+                If(statement);
+                break;
+            }
+        }
+
+        static std::vector<uint32_t> Indices(const std::string& mask, size_t width)
+        {
+            std::vector<uint32_t> indices;
+            if (mask.empty())
+            {
+                for (uint32_t i = 0; i < width; i++)
+                    indices.push_back(i);
+                return indices;
+            }
+
+            if (mask.size() > 4)
+                unsupported("member " + mask);
+
+            for (char c : mask)
+            {
+                const size_t index = std::string_view("xyzw").find(c) != std::string_view::npos ? std::string_view("xyzw").find(c) :
+                    std::string_view("rgba").find(c);
+                if (index == std::string_view::npos)
+                    unsupported("member " + mask);
+                indices.push_back(uint32_t(index));
+            }
+            return indices;
+        }
+
+        static Value Fit(const Value& value, size_t width)
+        {
+            if (value.size() == width)
+                return value;
+            if (value.size() == 1)
+                return Value(width, value[0]);
+            unsupported(fmt::format("{} components for {}", value.size(), width));
+        }
+
+        void Declare(const Statement& statement)
+        {
+            Type type;
+            uint32_t width;
+            if (!typeName(statement.type, type, width))
+                unsupported("type " + statement.type);
+            if (scopes.empty() || variables.count(statement.name) != 0 || context.constants.count(statement.name) != 0)
+                unsupported("declaration of " + statement.name);
+
+            Value value = Fit(Evaluate(*statement.expression), width);
+            for (auto& component : value)
+                component = terms.Convert(component, type);
+
+            variables.emplace(statement.name, Variable{ type, value });
+            scopes.back().push_back(statement.name);
+        }
+
+        void Assign(const Statement& statement)
+        {
+            Value value = Evaluate(*statement.expression);
+
+            auto found = variables.find(statement.name);
+            if (found == variables.end())
+                unsupported("assignment to " + statement.name);
+            Variable& variable = found->second;
+
+            const std::vector<uint32_t> indices = Indices(statement.mask, variable.components.size());
+            std::set<uint32_t> distinct(indices.begin(), indices.end());
+            if (distinct.size() != indices.size())
+                unsupported("repeated component in " + statement.mask);
+            for (uint32_t index : indices)
+            {
+                if (index >= variable.components.size())
+                    unsupported(fmt::format("{}.{}", statement.name, statement.mask));
+            }
+
+            if (statement.op != "=")
+            {
+                Value current;
+                for (uint32_t index : indices)
+                    current.push_back(variable.components[index]);
+                value = Binary(statement.op.substr(0, 1), current, value);
+            }
+
+            value = Fit(value, indices.size());
+            for (size_t k = 0; k < indices.size(); k++)
+            {
+                // The branch and the alpha test after it read the alpha: never written in the branch.
+                if (earlyOutDepth != 0 && statement.name == "oC0" && indices[k] == 3)
+                    mismatch("the early-out branch writes oC0.w");
+                variable.components[indices[k]] = terms.Convert(value[k], variable.type);
+            }
+        }
+
+        void If(const Statement& statement)
+        {
+            if (statement.condition == context.earlyOutCondition)
+            {
+                if (statement.statements.size() != 1 || earlyOutDepth != 0 || !path.empty())
+                    unsupported("early-out with else, nested or under a condition");
+
+                earlyOuts++;
+                earlyOutAlphas.push_back(Alpha());
+                if (earlyOutTaken)
+                {
+                    earlyOutDepth++;
+                    Execute(*statement.statements[0]);
+                    earlyOutDepth--;
+                }
+                return;
+            }
+
+            if (statement.condition == context.gatherVerifyCondition)
+            {
+                if (statement.statements.size() > 1)
+                    Execute(*statement.statements[1]);
+                return;
+            }
+
+            const Value condition = Evaluate(*statement.expression);
+            if (condition.size() != 1)
+                unsupported("vector condition");
+            const uint32_t c = terms.Convert(condition[0], Type::BOOL);
+
+            const std::map<std::string, Variable> before = variables;
+            path.push_back(c);
+            Execute(*statement.statements[0]);
+            path.pop_back();
+
+            std::map<std::string, Variable> taken = std::move(variables);
+            variables = before;
+            if (statement.statements.size() > 1)
+            {
+                path.push_back(terms.Not(c));
+                Execute(*statement.statements[1]);
+                path.pop_back();
+            }
+
+            for (auto& [name, variable] : variables)
+            {
+                auto found = taken.find(name);
+                if (found == taken.end() || found->second.components.size() != variable.components.size())
+                    unsupported("variable " + name + " changed shape in a branch");
+                for (size_t k = 0; k < variable.components.size(); k++)
+                    variable.components[k] = terms.Select(c, found->second.components[k], variable.components[k]);
+            }
+        }
+
+        static Type Promote(Type a, Type b)
+        {
+            if (a == Type::UNKNOWN || b == Type::UNKNOWN)
+                unsupported("operand of unknown type");
+            if (a == Type::FLOAT || b == Type::FLOAT)
+                return Type::FLOAT;
+            if (a == Type::UINT || b == Type::UINT)
+                return Type::UINT;
+            return Type::INT;
+        }
+
+        static size_t Width(const std::vector<const Value*>& values)
+        {
+            size_t width = 1;
+            for (const Value* value : values)
+            {
+                if (value->empty())
+                    unsupported("empty value");
+                if (value->size() != 1)
+                {
+                    if (width != 1 && width != value->size())
+                        unsupported("operands of different widths");
+                    width = value->size();
+                }
+            }
+            return width;
+        }
+
+        static uint32_t At(const Value& value, size_t index)
+        {
+            return value.size() == 1 ? value[0] : value[index];
+        }
+
+        Value Binary(const std::string& op, const Value& a, const Value& b)
+        {
+            const size_t width = Width({ &a, &b });
+            Value result;
+            for (size_t i = 0; i < width; i++)
+            {
+                uint32_t x = At(a, i);
+                uint32_t y = At(b, i);
+                if (op == "&&" || op == "||")
+                {
+                    result.push_back(terms.Make(op, { terms.Convert(x, Type::BOOL), terms.Convert(y, Type::BOOL) }, Type::BOOL));
+                    continue;
+                }
+
+                const Type type = Promote(terms.TypeOf(x), terms.TypeOf(y));
+                x = terms.Convert(x, type);
+                y = terms.Convert(y, type);
+                if (op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=")
+                {
+                    result.push_back(terms.Make(op, { x, y }, Type::BOOL));
+                }
+                else if (op == "+" || op == "-" || op == "*" || op == "/" || op == "%")
+                {
+                    result.push_back(terms.Make(op, { x, y }, type));
+                }
+                else if (op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>")
+                {
+                    if (type == Type::FLOAT)
+                        unsupported("bitwise operator on float");
+                    result.push_back(terms.Make(op, { x, y }, type));
+                }
+                else
+                {
+                    unsupported("operator " + op);
+                }
+            }
+            return result;
+        }
+
+        uint32_t Pack(const Value& value)
+        {
+            return terms.Make("vector", value, Type::UNKNOWN);
+        }
+
+        Value Evaluate(const Expression& expression)
+        {
+            switch (expression.kind)
+            {
+            case Expression::Kind::NUMBER:
+            {
+                const std::string& text = expression.text;
+                const bool hex = text.size() > 1 && (text[1] == 'x' || text[1] == 'X');
+                Type type = Type::INT;
+                if (!hex && (text.find('.') != std::string::npos || text.find_first_of("eEfFhH") != std::string::npos))
+                    type = Type::FLOAT;
+                else if (text.find_first_of("uU") != std::string::npos)
+                    type = Type::UINT;
+                return { terms.Make("literal " + text, {}, type) };
+            }
+
+            case Expression::Kind::IDENTIFIER:
+                return Identifier(expression.text);
+
+            case Expression::Kind::MEMBER:
+            {
+                const Value value = Evaluate(*expression.operands[0]);
+                const std::vector<uint32_t> indices = Indices(expression.text, value.size());
+                Value result;
+                for (uint32_t index : indices)
+                {
+                    if (value.size() == 1 && index == 0)
+                        result.push_back(value[0]);
+                    else if (index < value.size())
+                        result.push_back(value[index]);
+                    else
+                        unsupported("swizzle ." + expression.text);
+                }
+                return result;
+            }
+
+            case Expression::Kind::UNARY:
+            {
+                Value value = Evaluate(*expression.operands[0]);
+                for (auto& component : value)
+                {
+                    if (expression.text == "-")
+                    {
+                        if (terms.TypeOf(component) == Type::BOOL)
+                            component = terms.Convert(component, Type::INT);
+                        component = terms.Make("negate", { component }, terms.TypeOf(component));
+                    }
+                    else if (expression.text == "!")
+                    {
+                        component = terms.Not(component);
+                    }
+                    else if (expression.text == "~")
+                    {
+                        if (terms.TypeOf(component) == Type::FLOAT)
+                            unsupported("~ on float");
+                        component = terms.Make("~", { component }, terms.TypeOf(component));
+                    }
+                }
+                return value;
+            }
+
+            case Expression::Kind::BINARY:
+                return Binary(expression.text, Evaluate(*expression.operands[0]), Evaluate(*expression.operands[1]));
+
+            case Expression::Kind::TERNARY:
+            {
+                const Value condition = Evaluate(*expression.operands[0]);
+                const Value whenTrue = Evaluate(*expression.operands[1]);
+                const Value whenFalse = Evaluate(*expression.operands[2]);
+                const size_t width = Width({ &condition, &whenTrue, &whenFalse });
+                Value result;
+                for (size_t i = 0; i < width; i++)
+                {
+                    const Type type = Promote(terms.TypeOf(At(whenTrue, i)), terms.TypeOf(At(whenFalse, i)));
+                    result.push_back(terms.Make("?:", { terms.Convert(At(condition, i), Type::BOOL),
+                        terms.Convert(At(whenTrue, i), type), terms.Convert(At(whenFalse, i), type) }, type));
+                }
+                return result;
+            }
+
+            case Expression::Kind::CAST:
+            {
+                Type type;
+                uint32_t width;
+                typeName(expression.text, type, width);
+                Value value = Evaluate(*expression.operands[0]);
+                if (value.size() == 1)
+                    value = Value(width, value[0]);
+                else if (value.size() >= width)
+                    value.resize(width);
+                else
+                    unsupported("cast to more components");
+                for (auto& component : value)
+                    component = terms.Convert(component, type);
+                return value;
+            }
+
+            case Expression::Kind::CALL:
+                return Call(expression);
+            }
+
+            unsupported("expression");
+        }
+
+        Value Identifier(const std::string& name)
+        {
+            auto variable = variables.find(name);
+            if (variable != variables.end())
+                return variable->second.components;
+
+            if (name == "true" || name == "false")
+                return { terms.Make("literal " + name, {}, Type::BOOL) };
+
+            auto constant = context.constants.find(name);
+            if (constant != context.constants.end())
+            {
+                Value value;
+                for (uint32_t i = 0; i < constant->second.second; i++)
+                    value.push_back(terms.Make(fmt::format("constant {}.{}", name, "xyzw"[i]), {}, constant->second.first));
+                return value;
+            }
+
+            unsupported("identifier " + name);
+        }
+
+        Value Call(const Expression& expression)
+        {
+            const std::string& name = expression.text;
+
+            // Constructors: the components of the arguments in order, each converted.
+            Type constructorType;
+            uint32_t constructorWidth;
+            if (typeName(name, constructorType, constructorWidth))
+            {
+                Value value;
+                for (auto& operand : expression.operands)
+                {
+                    for (uint32_t component : Evaluate(*operand))
+                        value.push_back(terms.Convert(component, constructorType));
+                }
+                if (expression.operands.size() == 1 && value.size() == 1)
+                    value = Value(constructorWidth, value[0]);
+                if (value.size() != constructorWidth)
+                    unsupported("constructor " + name);
+                return value;
+            }
+
+            std::vector<Value> arguments;
+            for (auto& operand : expression.operands)
+                arguments.push_back(Evaluate(*operand));
+
+            // Component-wise intrinsics (HLSL broadcasts scalar arguments).
+            static const std::set<std::string> MATH =
+            {
+                "saturate", "abs", "rcp", "rsqrt", "sqrt", "log2", "exp2", "frac", "floor", "ceil", "trunc", "round", "sign",
+                "sin", "cos", "min", "max", "clamp",
+            };
+            static const std::set<std::string> SELECT = { "select", "selectWrapper" };
+            static const std::map<std::string, Type> BIT_CASTS = { { "asfloat", Type::FLOAT }, { "asuint", Type::UINT }, { "asint", Type::INT } };
+            static const std::set<std::string> CLASSIFY = { "isnan", "isinf" };
+
+            const bool math = MATH.count(name) != 0;
+            const bool select = SELECT.count(name) != 0;
+            const auto bitCast = BIT_CASTS.find(name);
+            const bool classify = CLASSIFY.count(name) != 0;
+            if (math || select || bitCast != BIT_CASTS.end() || classify)
+            {
+                if (arguments.empty() || (select && arguments.size() != 3))
+                    unsupported("arguments of " + name);
+
+                std::vector<const Value*> values;
+                for (auto& argument : arguments)
+                    values.push_back(&argument);
+                const size_t width = Width(values);
+
+                Value result;
+                for (size_t i = 0; i < width; i++)
+                {
+                    std::vector<uint32_t> operands;
+                    Type type = Type::UNKNOWN;
+                    if (math)
+                    {
+                        type = terms.TypeOf(At(arguments[0], i));
+                        for (auto& argument : arguments)
+                            type = Promote(type, terms.TypeOf(At(argument, i)));
+                        for (auto& argument : arguments)
+                            operands.push_back(terms.Convert(At(argument, i), type));
+                    }
+                    else if (select)
+                    {
+                        type = Promote(terms.TypeOf(At(arguments[1], i)), terms.TypeOf(At(arguments[2], i)));
+                        operands = { terms.Convert(At(arguments[0], i), Type::BOOL), terms.Convert(At(arguments[1], i), type),
+                            terms.Convert(At(arguments[2], i), type) };
+                    }
+                    else
+                    {
+                        type = classify ? Type::BOOL : bitCast->second;
+                        for (auto& argument : arguments)
+                            operands.push_back(At(argument, i));
+                    }
+                    result.push_back(terms.Make("call " + name, operands, type));
+                }
+                return result;
+            }
+
+            // Functions of whole vectors: the call as one term, then its components. `implicitLod`: a fetch with
+            // an implicit level of detail or a derivative (the weights too, conservatively).
+            struct VectorFunction
+            {
+                Type type;
+                uint32_t width;
+                bool implicitLod;
+            };
+            static const std::map<std::string, VectorFunction> VECTOR_FUNCTIONS =
+            {
+                { "dot", { Type::FLOAT, 1, false } },
+                { "length", { Type::FLOAT, 1, false } },
+                { "distance", { Type::FLOAT, 1, false } },
+                { "any", { Type::BOOL, 1, false } },
+                { "all", { Type::BOOL, 1, false } },
+                { "max4", { Type::FLOAT, 1, false } },
+                { "cube", { Type::FLOAT, 4, false } },
+                { "g_SpecConstants", { Type::UINT, 1, false } },
+                { "tfetch2DArrayGather", { Type::FLOAT, 4, false } },
+                { "tfetch2DArrayGatherExact", { Type::BOOL, 1, false } },
+                { "tfetch1D", { Type::FLOAT, 4, true } },
+                { "tfetch2D", { Type::FLOAT, 4, true } },
+                { "tfetch2DArray", { Type::FLOAT, 4, true } },
+                { "tfetch3D", { Type::FLOAT, 4, true } },
+                { "tfetchCube", { Type::FLOAT, 4, true } },
+                { "tfetch2DBicubic", { Type::FLOAT, 4, true } },
+                { "getWeights2D", { Type::FLOAT, 2, true } },
+                { "getWeights2DArray", { Type::FLOAT, 3, true } },
+                { "ddx", { Type::FLOAT, 4, true } },
+                { "ddy", { Type::FLOAT, 4, true } },
+                { "fwidth", { Type::FLOAT, 4, true } },
+            };
+
+            VectorFunction info;
+            auto found = VECTOR_FUNCTIONS.find(name);
+            if (found != VECTOR_FUNCTIONS.end())
+            {
+                info = found->second;
+            }
+            else
+            {
+                // A constant array's accessor, g_Name(INDEX).
+                auto constant = context.constants.find(name);
+                if (constant == context.constants.end() || constant->second.second != 4 || arguments.size() != 1)
+                    unsupported("function " + name);
+                info = { constant->second.first, 4, false };
+            }
+
+            std::vector<uint32_t> operands;
+            for (auto& argument : arguments)
+                operands.push_back(Pack(argument));
+            const uint32_t call = terms.Make("call " + name, operands, info.type);
+
+            if (info.implicitLod)
+            {
+                // Needs every pixel of its 2x2 quad: never in the branch that pixels skip one by one.
+                if (earlyOutDepth != 0)
+                    mismatch(name + " (implicit level of detail) in the early-out branch");
+                implicitLod.emplace_back(call, terms.Make("conditions", path, Type::BOOL));
+            }
+
+            if (info.width == 1)
+                return { call };
+
+            Value value;
+            for (uint32_t i = 0; i < info.width; i++)
+                value.push_back(terms.Make(fmt::format("component {}", i), { call }, info.type));
+            return value;
+        }
+    };
+
+    std::unique_ptr<Statement> parse(const std::vector<std::string>& source)
+    {
+        std::string text;
+        for (auto& line : source)
+        {
+            text += line;
+            text += '\n';
+        }
+        Parser parser(tokenize(text));
+        return parser.ParseBlockContents();
+    }
+}
+
+SinkCheckResult checkAlphaTestSink(const std::string& previous, const std::string& sunk, std::string& message)
+{
+    try
+    {
+        const std::vector<std::string> previousLines = lines(previous);
+        const std::vector<std::string> sunkLines = lines(sunk);
+
+        // The wrapper: the variant, then the previous body in the else block (SPIR-V) or alone (other backends).
+        size_t sinkIf = SIZE_MAX;
+        for (size_t i = 0; i < sunkLines.size(); i++)
+        {
+            if (sunkLines[i] == SINK_IF)
+            {
+                if (sinkIf != SIZE_MAX)
+                    mismatch("several variants");
+                sinkIf = i;
+            }
+        }
+        if (sinkIf == SIZE_MAX || sinkIf == 0 || sunkLines[sinkIf - 1] != "#ifdef __spirv__" || sinkIf + 2 >= sunkLines.size() ||
+            sunkLines[sinkIf + 1] != "\t{")
+        {
+            mismatch("no variant wrapper");
+        }
+
+        const size_t variantEnd = closingLine(sunkLines, sinkIf + 1, 0);
+        if (variantEnd + 4 >= sunkLines.size() || sunkLines[variantEnd] != "\t}" || sunkLines[variantEnd + 1] != "\telse" ||
+            sunkLines[variantEnd + 2] != "\t{" || sunkLines[variantEnd + 3] != "#endif")
+        {
+            mismatch("the variant's wrapper");
+        }
+
+        const size_t elseEnd = closingLine(sunkLines, variantEnd + 4, 1);
+        if (sunkLines[elseEnd] != "\t}" || elseEnd == 0 || sunkLines[elseEnd - 1] != "#ifdef __spirv__" ||
+            elseEnd + 1 >= sunkLines.size() || sunkLines[elseEnd + 1] != "#endif")
+        {
+            mismatch("the previous code's wrapper");
+        }
+
+        // Without the variant and the wrapper: the previous text, exactly.
+        const size_t bodyStart = sinkIf - 1;
+        const size_t bodyEnd = bodyStart + (elseEnd - 1 - (variantEnd + 4));
+        {
+            std::vector<std::string> rebuilt(sunkLines.begin(), sunkLines.begin() + bodyStart);
+            rebuilt.insert(rebuilt.end(), sunkLines.begin() + variantEnd + 4, sunkLines.begin() + elseEnd - 1);
+            rebuilt.insert(rebuilt.end(), sunkLines.begin() + elseEnd + 2, sunkLines.end());
+            if (rebuilt != previousLines)
+                mismatch("the text outside the variant is not the previous text");
+        }
+
+        // After the body: the verification output, then the alpha test and the blend skip's discard, which discard
+        // every pixel that skips the early-out branch.
+        size_t tail = bodyEnd;
+        if (tail + 3 <= previousLines.size() && previousLines[tail] == "#ifdef __spirv__" && previousLines[tail + 1] == VERIFY_OUTPUT &&
+            previousLines[tail + 2] == "#endif")
+        {
+            tail += 3;
+        }
+        if (tail + 3 > previousLines.size() || previousLines[tail] != ALPHA_TEST || previousLines[tail + 1] != "#ifdef __spirv__" ||
+            previousLines[tail + 2] != BLEND_SKIP_ALPHA)
+        {
+            unsupported("the code after the body");
+        }
+
+        Context context;
+        context.earlyOutCondition = tokenTexts(EARLY_OUT_CONDITION);
+        context.gatherVerifyCondition = tokenTexts(GATHER_VERIFY_CONDITION);
+
+        // Main's variables at the start of the body (declared at its top level, one tab in), and the outputs.
+        size_t mainOpen = SIZE_MAX;
+        for (size_t i = 0; i < bodyStart; i++)
+        {
+            if (previousLines[i].rfind("PixelShaderOutput shaderMain(", 0) == 0)
+            {
+                for (size_t j = i + 1; j < bodyStart; j++)
+                {
+                    if (previousLines[j] == "{")
+                    {
+                        mainOpen = j;
+                        break;
+                    }
+                }
+                break;
+            }
+        }
+        if (mainOpen == SIZE_MAX)
+            unsupported("no main");
+
+        static const std::regex OUTPUT(R"(^#define (oC[0-3]|oDepth) output\.(oC[0-3]|oDepth)$)");
+        static const std::regex DECLARATION(R"(^\t([a-z]+[1-4]?) ([A-Za-z_]\w*) = (.*);$)");
+        static const std::regex LITERAL(R"(^(-?[0-9]+(\.[0-9]+)?|true|false)$)");
+        std::vector<std::string> header;
+        for (size_t i = mainOpen + 1; i < bodyStart; i++)
+        {
+            std::smatch match;
+            if (std::regex_match(previousLines[i], match, OUTPUT))
+            {
+                if (match[1].str() != match[2].str())
+                    unsupported("output alias " + previousLines[i]);
+                const std::string name = match[1].str();
+                context.variables.emplace(name, Variable{ Type::FLOAT, {} });
+                context.outputs.insert(name);
+                header.push_back("");
+                continue;
+            }
+            header.push_back(previousLines[i]);
+        }
+
+        Terms terms;
+        for (auto& [name, output] : context.variables)
+        {
+            const uint32_t width = name == "oDepth" ? 1 : 4;
+            for (uint32_t i = 0; i < width; i++)
+                output.components.push_back(terms.Make(fmt::format("initial {}.{}", name, "xyzw"[i]), {}, Type::FLOAT));
+        }
+
+        for (auto& line : spirvView(header, 0, header.size()))
+        {
+            std::smatch match;
+            Type type;
+            uint32_t width;
+            if (!std::regex_match(line, match, DECLARATION) || !typeName(match[1].str(), type, width))
+                continue;
+
+            const std::string name = match[2].str();
+            const std::string initial = trim(match[3].str());
+            if (context.variables.count(name) != 0)
+                unsupported("variable declared twice: " + name);
+
+            Variable variable{ type, {} };
+            for (uint32_t i = 0; i < width; i++)
+            {
+                // A literal initial value (0.0, false...) is that value: gatherMismatch must still be false at the end.
+                if (std::regex_match(initial, LITERAL))
+                {
+                    const bool number = initial != "true" && initial != "false";
+                    const Type literalType = !number ? Type::BOOL : initial.find('.') != std::string::npos ? Type::FLOAT : Type::INT;
+                    variable.components.push_back(terms.Convert(terms.Make("literal " + initial, {}, literalType), type));
+                }
+                else
+                {
+                    variable.components.push_back(terms.Make(fmt::format("initial {}.{}", name, "xyzw"[i]), {}, type));
+                }
+            }
+            context.variables.emplace(name, variable);
+        }
+
+        if (context.variables.count("oC0") == 0 || context.variables.count("gatherMismatch") == 0)
+            unsupported("no oC0 or gatherMismatch");
+
+        // Constants: the cbuffer members (D3D12's declarations; SPIR-V reads the same registers through its macros),
+        // and the shared ones the translated code reads.
+        static const std::regex MEMBER(R"(^\t(float[1-4]?|uint|int|bool) ([A-Za-z_]\w*)(\[[0-9]+\])? : packoffset\(c[0-9]+(\.[xyzw])?\);$)");
+        for (size_t i = 0; i < bodyStart; i++)
+        {
+            std::smatch match;
+            Type type;
+            uint32_t width;
+            if (std::regex_match(previousLines[i], match, MEMBER) && typeName(match[1].str(), type, width))
+                context.constants[match[2].str()] = { type, width };
+        }
+        context.constants["FLT_MAX"] = { Type::FLOAT, 1 };
+        context.constants["FLT_MIN"] = { Type::FLOAT, 1 };
+        context.constants["g_AlphaThreshold"] = { Type::FLOAT, 1 };
+        context.constants["g_GatherableSlots"] = { Type::UINT, 1 };
+        {
+            static const std::regex SHARED(R"(\b(SPEC_CONSTANT_\w+|\w+DescriptorIndex|\w+_Texture2DArraySize|\w+_Texture2DSize)\b)");
+            for (auto it = std::sregex_iterator(previous.begin(), previous.end(), SHARED); it != std::sregex_iterator(); ++it)
+            {
+                const std::string name = (*it)[1].str();
+                if (context.constants.count(name) != 0 || context.variables.count(name) != 0)
+                    continue;
+                if (name.rfind("SPEC_CONSTANT_", 0) == 0)
+                    context.constants[name] = { Type::INT, 1 };
+                else if (name.size() > 15 && name.compare(name.size() - 15, 15, "DescriptorIndex") == 0)
+                    context.constants[name] = { Type::UINT, 1 };
+                else if (name.size() > 20 && name.compare(name.size() - 20, 20, "_Texture2DArraySize") == 0)
+                    context.constants[name] = { Type::FLOAT, 4 };
+                else
+                    context.constants[name] = { Type::FLOAT, 2 };
+            }
+        }
+
+        // What the code after the body reads of main's variables (beyond the outputs and gatherMismatch).
+        std::set<std::string> readAfter;
+        {
+            static const std::regex IDENTIFIER(R"(\b[A-Za-z_]\w*\b)");
+            for (size_t i = bodyEnd; i < previousLines.size(); i++)
+            {
+                const std::string& line = previousLines[i];
+                for (auto it = std::sregex_iterator(line.begin(), line.end(), IDENTIFIER); it != std::sregex_iterator(); ++it)
+                {
+                    const std::string name = it->str();
+                    if (context.variables.count(name) != 0)
+                        readAfter.insert(name);
+                }
+            }
+            for (auto& name : context.outputs)
+                readAfter.insert(name);
+            readAfter.insert("gatherMismatch");
+        }
+
+        const auto previousBody = parse(spirvView(previousLines, bodyStart, bodyEnd));
+        const auto variantBody = parse(spirvView(sunkLines, sinkIf + 2, variantEnd));
+
+        Evaluator previousKept(terms, context, true);
+        Evaluator previousDiscarded(terms, context, false);
+        Evaluator variantKept(terms, context, true);
+        Evaluator variantDiscarded(terms, context, false);
+        previousKept.Run(*previousBody);
+        previousDiscarded.Run(*previousBody);
+        variantKept.Run(*variantBody);
+        variantDiscarded.Run(*variantBody);
+
+        if (previousKept.topLevelDeclarations)
+            unsupported("declarations at the top level of the body");
+        if (previousKept.earlyOuts > 1)
+            unsupported("several early-outs in the previous code");
+        if (variantKept.earlyOuts != 1 || variantDiscarded.earlyOuts != 1)
+            mismatch("the variant has no single early-out branch");
+
+        // The alpha: every early-out tests the final alpha of the previous code, and a pixel that skips the branch
+        // leaves with it.
+        const uint32_t alpha = previousKept.Alpha();
+        for (const Evaluator* evaluator : { &previousKept, &previousDiscarded, &variantKept, &variantDiscarded })
+        {
+            if (evaluator->Alpha() != alpha)
+                mismatch("oC0.w: " + terms.Describe(evaluator->Alpha()) + " instead of " + terms.Describe(alpha));
+            for (uint32_t tested : evaluator->earlyOutAlphas)
+            {
+                if (tested != alpha)
+                    mismatch("the early-out tests " + terms.Describe(tested) + " instead of " + terms.Describe(alpha));
+            }
+        }
+
+        // A pixel that skips the branch: nothing may turn it magenta (the alpha the alpha test reads).
+        const uint32_t noMismatch = terms.Make("literal false", {}, Type::BOOL);
+        for (const Evaluator* evaluator : { &previousDiscarded, &variantDiscarded })
+        {
+            if (evaluator->variables.at("gatherMismatch").components[0] != noMismatch)
+                mismatch("gatherMismatch may be set");
+        }
+
+        // A pixel that runs the branch: everything the rest of the shader reads.
+        for (auto& name : readAfter)
+        {
+            const Variable& a = previousKept.variables.at(name);
+            const Variable& b = variantKept.variables.at(name);
+            for (size_t k = 0; k < a.components.size(); k++)
+            {
+                if (a.components[k] != b.components[k])
+                {
+                    mismatch(fmt::format("{}.{}: {} instead of {}", name, "xyzw"[k], terms.Describe(b.components[k]),
+                        terms.Describe(a.components[k])));
+                }
+            }
+        }
+
+        // The same fetches with an implicit level of detail and derivatives, under the same conditions.
+        auto previousLod = previousKept.implicitLod;
+        auto variantLod = variantKept.implicitLod;
+        std::sort(previousLod.begin(), previousLod.end());
+        std::sort(variantLod.begin(), variantLod.end());
+        if (previousLod != variantLod)
+            mismatch(fmt::format("{} fetches with an implicit level of detail instead of {}, or other ones", variantLod.size(), previousLod.size()));
+    }
+    catch (const CheckFailure& failure)
+    {
+        message = failure.message;
+        return failure.result;
+    }
+    catch (const std::exception& exception)
+    {
+        message = exception.what();
+        return SinkCheckResult::UNSUPPORTED;
+    }
+
+    return SinkCheckResult::EQUIVALENT;
+}
+
+#endif
diff --git a/XenosRecomp/sink_check.h b/XenosRecomp/sink_check.h
new file mode 100644
index 0000000..ae31ce5
--- /dev/null
+++ b/XenosRecomp/sink_check.h
@@ -0,0 +1,30 @@
+#pragma once
+
+#include <string>
+
+// SPEC_CONSTANT_ALPHA_TEST_SINK: an independent proof that the sunk variant of a pixel shader
+// (ShaderRecompiler::sinkIntoAlphaTestEarlyOut) computes what the previous code computes. It shares no code
+// with the sinking: it parses both texts again as DXC sees them for SPIR-V, executes each symbolically (every
+// value a term built from the operations and operands that compute it, identical terms for identical
+// computations), and compares:
+//
+// - the text: without the variant and its wrapper, the sunk text must be the previous text, character for
+//   character (so the other backends, and Vulkan without the bit, compile exactly the previous code);
+// - for a pixel that runs the early-out branch: every output, and everything the code after the branch reads,
+//   with the same term in both;
+// - for a pixel that skips it: the alpha the branch tests is the alpha of the previous code, and nothing can
+//   stop the alpha test (or the blend skip) from discarding it;
+// - fetches with an implicit level of detail and derivatives: none in the branch, and the same calls (same
+//   arguments) under the same conditions as before.
+//
+// The variant only runs under UR_ALPHA_TEST_SINK (shader_common.h), which excludes the verification bits: the
+// check takes the gather verification as off, and assumes the size helpers only report a mismatch with
+// SPEC_CONSTANT_TEXTURE_SIZE_VERIFY.
+enum class SinkCheckResult
+{
+    EQUIVALENT,  // proven: the shader may use its variant
+    UNSUPPORTED, // a construct the check does not model: the shader keeps its previous code
+    MISMATCH,    // the variant differs (a translator bug): the generation must fail
+};
+
+SinkCheckResult checkAlphaTestSink(const std::string& previous, const std::string& sunk, std::string& message);
diff --git a/XenosRecomp/spirv_patch.cpp b/XenosRecomp/spirv_patch.cpp
new file mode 100644
index 0000000..a5af265
--- /dev/null
+++ b/XenosRecomp/spirv_patch.cpp
@@ -0,0 +1,283 @@
+#include "spirv_patch.h"
+
+namespace
+{
+    // SPIR-V 1.0 opcodes, decorations and built-ins used here.
+    constexpr uint32_t OP_TYPE_BOOL = 20;
+    constexpr uint32_t OP_TYPE_INT = 21;
+    constexpr uint32_t OP_CONSTANT = 43;
+    constexpr uint32_t OP_SPEC_CONSTANT = 50;
+    constexpr uint32_t OP_FUNCTION = 54;
+    constexpr uint32_t OP_FUNCTION_CALL = 57;
+    constexpr uint32_t OP_LOAD = 61;
+    constexpr uint32_t OP_STORE = 62;
+    constexpr uint32_t OP_COPY_MEMORY = 63;
+    constexpr uint32_t OP_COPY_MEMORY_SIZED = 64;
+    constexpr uint32_t OP_ACCESS_CHAIN = 65;
+    constexpr uint32_t OP_IN_BOUNDS_ACCESS_CHAIN = 66;
+    constexpr uint32_t OP_PTR_ACCESS_CHAIN = 67;
+    constexpr uint32_t OP_IN_BOUNDS_PTR_ACCESS_CHAIN = 70;
+    constexpr uint32_t OP_DECORATE = 71;
+    constexpr uint32_t OP_COPY_OBJECT = 83;
+    constexpr uint32_t OP_SELECT = 169;
+    constexpr uint32_t OP_IEQUAL = 170;
+    constexpr uint32_t OP_BITWISE_AND = 199;
+    constexpr uint32_t OP_ATOMIC_FIRST = 227; // OpAtomicLoad .. OpAtomicXor: the pointer is the third word.
+    constexpr uint32_t OP_ATOMIC_LAST = 242;
+    constexpr uint32_t OP_PHI = 245;
+    constexpr uint32_t OP_SELECTION_MERGE = 247;
+    constexpr uint32_t OP_LABEL = 248;
+    constexpr uint32_t OP_BRANCH = 249;
+    constexpr uint32_t OP_BRANCH_CONDITIONAL = 250;
+    constexpr uint32_t OP_RETURN = 253;
+    constexpr uint32_t OP_PTR_EQUAL = 401; // .. OpPtrDiff (403)
+    constexpr uint32_t OP_PTR_DIFF = 403;
+
+    constexpr uint32_t DECORATION_SPEC_ID = 1;
+    constexpr uint32_t DECORATION_BUILT_IN = 11;
+    constexpr uint32_t BUILT_IN_CLIP_DISTANCE = 3;
+
+    constexpr uint32_t SELECTION_CONTROL_NONE = 0;
+
+    uint32_t header(uint32_t opcode, uint32_t wordCount)
+    {
+        return (wordCount << 16) | opcode;
+    }
+
+    // Whether the instruction at `at` takes `id` as a pointer operand. These are all the instructions through which
+    // a module without the VariablePointers capabilities can reach a variable (loads, stores, copies, access chains,
+    // atomics, calls, and pointer phis, selects and comparisons, which such a module cannot have, for good measure).
+    bool usesPointer(const std::vector<uint32_t>& words, size_t at, uint32_t id)
+    {
+        const uint32_t opcode = words[at] & 0xFFFF;
+        const uint32_t count = words[at] >> 16;
+        auto operand = [&](uint32_t index) { return index < count && words[at + index] == id; };
+
+        switch (opcode)
+        {
+        case OP_LOAD:
+        case OP_COPY_OBJECT:
+        case OP_ACCESS_CHAIN:
+        case OP_IN_BOUNDS_ACCESS_CHAIN:
+        case OP_PTR_ACCESS_CHAIN:
+        case OP_IN_BOUNDS_PTR_ACCESS_CHAIN:
+            return operand(3);
+        case OP_STORE:
+            return operand(1);
+        case OP_COPY_MEMORY:
+        case OP_COPY_MEMORY_SIZED:
+            return operand(1) || operand(2);
+        case OP_SELECT:
+            return operand(4) || operand(5);
+        case OP_FUNCTION_CALL:
+            for (uint32_t i = 4; i < count; i++)
+            {
+                if (operand(i))
+                    return true;
+            }
+            return false;
+        case OP_PHI:
+            for (uint32_t i = 3; i < count; i += 2)
+            {
+                if (operand(i))
+                    return true;
+            }
+            return false;
+        default:
+            if (opcode >= OP_ATOMIC_FIRST && opcode <= OP_ATOMIC_LAST)
+                return operand(3);
+            if (opcode >= OP_PTR_EQUAL && opcode <= OP_PTR_DIFF)
+                return operand(3) || operand(4);
+            return false;
+        }
+    }
+}
+
+bool makeClipDistanceStoreConditional(std::vector<uint32_t>& words, uint32_t specBit, std::string& reason)
+{
+    if (words.size() < 5 || words[0] != 0x07230203)
+    {
+        reason = "not a SPIR-V module";
+        return false;
+    }
+
+    std::vector<size_t> instructions;
+    for (size_t i = 5; i < words.size();)
+    {
+        const uint32_t count = words[i] >> 16;
+        if (count == 0 || i + count > words.size())
+        {
+            reason = "malformed module";
+            return false;
+        }
+
+        instructions.push_back(i);
+        i += count;
+    }
+
+    // The ClipDistance output and specialization constant 0 (g_SpecConstants, a uint).
+    uint32_t clipDistance = 0;
+    uint32_t specConstantsId = 0;
+    for (size_t at : instructions)
+    {
+        const uint32_t opcode = words[at] & 0xFFFF;
+        const uint32_t count = words[at] >> 16;
+        if (opcode == OP_DECORATE && count >= 4 && words[at + 2] == DECORATION_BUILT_IN && words[at + 3] == BUILT_IN_CLIP_DISTANCE)
+        {
+            if (clipDistance != 0)
+            {
+                reason = "two ClipDistance variables";
+                return false;
+            }
+            clipDistance = words[at + 1];
+        }
+        else if (opcode == OP_DECORATE && count >= 4 && words[at + 2] == DECORATION_SPEC_ID && words[at + 3] == 0)
+        {
+            specConstantsId = words[at + 1];
+        }
+    }
+
+    if (clipDistance == 0)
+    {
+        reason = "no ClipDistance output";
+        return false;
+    }
+    if (specConstantsId == 0)
+    {
+        reason = "no specialization constant 0";
+        return false;
+    }
+
+    // The types and constants the test needs (made when missing), and the one function.
+    uint32_t uintType = 0;
+    uint32_t boolType = 0;
+    uint32_t zero = 0;
+    uint32_t bit = 0;
+    bool specConstantsIsUint = false;
+    size_t firstFunction = SIZE_MAX;
+    uint32_t functions = 0;
+    for (size_t i = 0; i < instructions.size(); i++)
+    {
+        const size_t at = instructions[i];
+        const uint32_t opcode = words[at] & 0xFFFF;
+        const uint32_t count = words[at] >> 16;
+
+        if (opcode == OP_FUNCTION)
+        {
+            if (firstFunction == SIZE_MAX)
+                firstFunction = i;
+            functions++;
+        }
+        else if (firstFunction == SIZE_MAX)
+        {
+            if (opcode == OP_TYPE_INT && count == 4 && words[at + 2] == 32 && words[at + 3] == 0)
+                uintType = words[at + 1];
+            else if (opcode == OP_TYPE_BOOL && count == 2)
+                boolType = words[at + 1];
+            else if (opcode == OP_CONSTANT && count == 4 && uintType != 0 && words[at + 1] == uintType)
+            {
+                if (words[at + 3] == 0 && zero == 0)
+                    zero = words[at + 2];
+                if (words[at + 3] == specBit && bit == 0)
+                    bit = words[at + 2];
+            }
+            else if (opcode == OP_SPEC_CONSTANT && count == 4 && words[at + 2] == specConstantsId)
+            {
+                specConstantsIsUint = uintType != 0 && words[at + 1] == uintType;
+            }
+        }
+    }
+
+    if (!specConstantsIsUint)
+    {
+        reason = "specialization constant 0 is not a uint OpSpecConstant";
+        return false;
+    }
+    if (functions != 1)
+    {
+        reason = "not exactly one function";
+        return false;
+    }
+
+    // The only use of the variable: the access chain of DXC's store, then the store, then the return.
+    size_t chain = SIZE_MAX;
+    for (size_t i = firstFunction; i < instructions.size(); i++)
+    {
+        if (!usesPointer(words, instructions[i], clipDistance))
+            continue;
+
+        const uint32_t opcode = words[instructions[i]] & 0xFFFF;
+        if (chain != SIZE_MAX || (opcode != OP_ACCESS_CHAIN && opcode != OP_IN_BOUNDS_ACCESS_CHAIN))
+        {
+            reason = "ClipDistance is used other than by one access chain";
+            return false;
+        }
+        chain = i;
+    }
+
+    if (chain == SIZE_MAX)
+    {
+        reason = "ClipDistance is never written";
+        return false;
+    }
+
+    const size_t store = chain + 1;
+    const size_t ret = chain + 2;
+    if (ret >= instructions.size() ||
+        (words[instructions[store]] & 0xFFFF) != OP_STORE || words[instructions[store] + 1] != words[instructions[chain] + 2] ||
+        words[instructions[ret]] != header(OP_RETURN, 1))
+    {
+        reason = "the store is not the access chain, OpStore, OpReturn of DXC";
+        return false;
+    }
+
+    uint32_t bound = words[3];
+    std::vector<uint32_t> declarations;
+    if (boolType == 0)
+    {
+        boolType = bound++;
+        declarations.insert(declarations.end(), { header(OP_TYPE_BOOL, 2), boolType });
+    }
+    if (zero == 0)
+    {
+        zero = bound++;
+        declarations.insert(declarations.end(), { header(OP_CONSTANT, 4), uintType, zero, 0 });
+    }
+    if (bit == 0)
+    {
+        bit = bound++;
+        declarations.insert(declarations.end(), { header(OP_CONSTANT, 4), uintType, bit, specBit });
+    }
+
+    const uint32_t masked = bound++;
+    const uint32_t condition = bound++;
+    const uint32_t writeLabel = bound++;
+    const uint32_t mergeLabel = bound++;
+
+    std::vector<uint32_t> result(words.begin(), words.begin() + instructions[firstFunction]);
+    result[3] = bound;
+    result.insert(result.end(), declarations.begin(), declarations.end());
+    result.insert(result.end(), words.begin() + instructions[firstFunction], words.begin() + instructions[chain]);
+
+    //     %masked = OpBitwiseAnd %uint %g_SpecConstants %bit
+    //  %condition = OpIEqual %bool %masked %zero
+    //               OpSelectionMerge %merge None
+    //               OpBranchConditional %condition %write %merge
+    //      %write = OpLabel
+    //               <the access chain and the store>
+    //               OpBranch %merge
+    //      %merge = OpLabel
+    //               OpReturn
+    result.insert(result.end(), { header(OP_BITWISE_AND, 5), uintType, masked, specConstantsId, bit });
+    result.insert(result.end(), { header(OP_IEQUAL, 5), boolType, condition, masked, zero });
+    result.insert(result.end(), { header(OP_SELECTION_MERGE, 3), mergeLabel, SELECTION_CONTROL_NONE });
+    result.insert(result.end(), { header(OP_BRANCH_CONDITIONAL, 4), condition, writeLabel, mergeLabel });
+    result.insert(result.end(), { header(OP_LABEL, 2), writeLabel });
+    result.insert(result.end(), words.begin() + instructions[chain], words.begin() + instructions[ret]);
+    result.insert(result.end(), { header(OP_BRANCH, 2), mergeLabel });
+    result.insert(result.end(), { header(OP_LABEL, 2), mergeLabel });
+    result.insert(result.end(), words.begin() + instructions[ret], words.end());
+
+    words = std::move(result);
+    return true;
+}
diff --git a/XenosRecomp/spirv_patch.h b/XenosRecomp/spirv_patch.h
new file mode 100644
index 0000000..6cb1135
--- /dev/null
+++ b/XenosRecomp/spirv_patch.h
@@ -0,0 +1,15 @@
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+// Edits of the SPIR-V DXC writes, for what HLSL cannot say.
+
+// Vertex shaders, SPEC_CONSTANT_NO_CLIP_DISTANCE: DXC stores the SV_ClipDistance member of the returned struct
+// into the ClipDistance output unconditionally, after everything else (OpAccessChain, OpStore, OpReturn). This puts
+// that store in `if ((g_SpecConstants & specBit) == 0)`, a new selection around the same two instructions, and
+// changes nothing else: with the bit clear the branch is always taken and the module computes what it did.
+// Returns false and leaves `words` as it was, with the reason in `reason`, when the module has another shape (no
+// clip distance, another use of it, no specialization constant 0...).
+bool makeClipDistanceStoreConditional(std::vector<uint32_t>& words, uint32_t specBit, std::string& reason);
