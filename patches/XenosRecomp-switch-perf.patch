+    // From line `begin` (inside `depth` open braces, preprocessor balanced), the line whose closing brace brings the
+    // depth back to 0, counting only what SPIR-V compiles.
+    size_t closingLine(const std::vector<std::string>& source, size_t begin, int depth)
+    {
+        std::vector<std::pair<bool, bool>> stack;
+        auto active = [&]() { return stack.empty() || stack.back().first; };
+
+        for (size_t i = begin; i < source.size(); i++)
+        {
+            const std::string text = trim(source[i]);
+            if (!text.empty() && text[0] == '#')
+            {
+                if (text.rfind("#ifdef ", 0) == 0 || text.rfind("#ifndef ", 0) == 0)
+                {
+                    const bool negated = text[3] == 'n';
+                    const bool condition = (trim(text.substr(negated ? 8 : 7)) == "__spirv__") != negated;
+                    const bool parent = active();
+                    stack.emplace_back(parent && condition, condition);
+                }
+                else if (text == "#else" && !stack.empty())
+                {
+                    const bool parent = stack.size() < 2 || stack[stack.size() - 2].first;
+                    stack.back().first = parent && !stack.back().second;
+                }
+                else if (text == "#endif" && !stack.empty())
+                {
+                    stack.pop_back();
+                }
+                else
