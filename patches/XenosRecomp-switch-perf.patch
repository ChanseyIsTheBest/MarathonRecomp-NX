+    // Tokens of HLSL expressions and statements.
+    struct Token
+    {
+        enum class Kind { IDENTIFIER, NUMBER, PUNCTUATOR, END };
+
+        Kind kind;
+        std::string text;
+    };
+
+    std::vector<Token> tokenize(std::string_view text)
+    {
+        static constexpr std::string_view TWO[] =
+        {
+            "||", "&&", "==", "!=", "<=", ">=", "<<", ">>", "+=", "-=", "*=", "/=", "%=", "&=", "|=", "^=", "++", "--",
+        };
+
+        std::vector<Token> tokens;
+        size_t i = 0;
+        while (i < text.size())
+        {
+            const char c = text[i];
+            if (isspace(uint8_t(c)))
+            {
+                i++;
+                continue;
+            }
+
+            if (isalpha(uint8_t(c)) || c == '_')
+            {
+                const size_t start = i;
+                while (i < text.size() && (isalnum(uint8_t(text[i])) || text[i] == '_'))
+                    i++;
+                tokens.push_back({ Token::Kind::IDENTIFIER, std::string(text.substr(start, i - start)) });
+                continue;
+            }
+
+            if (isdigit(uint8_t(c)) || (c == '.' && i + 1 < text.size() && isdigit(uint8_t(text[i + 1]))))
+            {
+                const size_t start = i;
+                if (c == '0' && i + 1 < text.size() && (text[i + 1] == 'x' || text[i + 1] == 'X'))
+                {
+                    i += 2;
+                    while (i < text.size() && isxdigit(uint8_t(text[i])))
+                        i++;
+                }
+                else
+                {
+                    while (i < text.size() && (isdigit(uint8_t(text[i])) || text[i] == '.'))
+                        i++;
+                    if (i < text.size() && (text[i] == 'e' || text[i] == 'E'))
+                    {
+                        i++;
+                        if (i < text.size() && (text[i] == '+' || text[i] == '-'))
+                            i++;
+                        while (i < text.size() && isdigit(uint8_t(text[i])))
+                            i++;
+                    }
+                }
+                while (i < text.size() && std::string_view("fFuUlLhH").find(text[i]) != std::string_view::npos)
+                    i++;
+                tokens.push_back({ Token::Kind::NUMBER, std::string(text.substr(start, i - start)) });
+                continue;
+            }
+
+            bool two = false;
+            for (auto op : TWO)
+            {
+                if (text.compare(i, 2, op) == 0)
+                {
+                    tokens.push_back({ Token::Kind::PUNCTUATOR, std::string(op) });
+                    i += 2;
+                    two = true;
+                    break;
+                }
+            }
+            if (two)
+                continue;
+
+            if (std::string_view("+-*/%<>=!~&|^?:;,.()[]{}").find(c) == std::string_view::npos)
+                unsupported(fmt::format("character '{}'", c));
+
+            tokens.push_back({ Token::Kind::PUNCTUATOR, std::string(1, c) });
+            i++;
+        }
+
+        tokens.push_back({ Token::Kind::END, std::string() });
+        return tokens;
+    }
