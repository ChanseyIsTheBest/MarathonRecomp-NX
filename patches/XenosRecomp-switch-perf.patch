+#ifdef XENOS_RECOMP_SWITCH_PERF
+static std::vector<std::string> splitLines(const std::string& text)
+{
+    std::vector<std::string> lines;
+    for (size_t start = 0; start <= text.size();)
+    {
+        size_t end = text.find('\n', start);
+        if (end == std::string::npos)
+            end = text.size();
+        lines.emplace_back(text, start, end - start);
+        start = end + 1;
+    }
+    return lines;
+}
+
+// Control flow in a line of translated code (predicate blocks, jumps, loops, the pc state machine).
+static bool hasControlFlow(const std::string& line)
+{
+    return line.find("if (") != std::string::npos || line.find("for (") != std::string::npos ||
+        line.find("switch") != std::string::npos || line.find("while") != std::string::npos ||
+        line.find("BRANCH") != std::string::npos || line.find("UNROLL") != std::string::npos ||
+        line.find("[branch]") != std::string::npos || line.find("case ") != std::string::npos;
+}
+
+// What straight-line code before line `end` leaves in each component of `registerName`: "x".."w" for that
+// component of the input the fetch regex matches (group 2: written mask, group 3: fetched swizzle), "0" or
+// "1" for those constants, "?" for anything else. False when there is control flow.
+static bool trackRegisterSources(const std::vector<std::string>& lines, size_t begin, size_t end,
+    const std::string& registerName, const std::regex& fetch, std::string sources[4])
+{
+    auto component = [](char c) { return c == 'x' ? 0 : c == 'y' ? 1 : c == 'z' ? 2 : 3; };
+
+    // Vertex shader registers start at 0 (declared before the code).
+    const bool zeroed = std::find(lines.begin(), lines.begin() + end, "\tfloat4 " + registerName + " = 0.0;") != lines.begin() + end;
+    for (size_t c = 0; c < 4; c++)
+        sources[c] = zeroed ? "0" : "?";
+
+    const std::regex writes("^\\t" + registerName + R"((?:\.([xyzw]+))?\s*[-+*/]?=[^=])");
+    const std::regex constant("^\t" + registerName + R"(\.([xyzw]) = (0|1)\.0;$)");
+    for (size_t i = begin; i < end; i++)
+    {
+        const std::string& line = lines[i];
+        if (hasControlFlow(line))
+            return false;
+
+        std::smatch write;
+        if (!std::regex_search(line, write, writes))
+            continue;
+
+        std::smatch match;
+        if (std::regex_match(line, match, fetch) && match[1].str() == registerName && match[2].length() == match[3].length())
+        {
+            for (size_t j = 0; j < size_t(match[2].length()); j++)
+                sources[component(match[2].str()[j])] = std::string(1, match[3].str()[j]);
+        }
+        else if (std::regex_match(line, match, constant))
+        {
+            sources[component(match[1].str()[0])] = match[2].str();
+        }
+        else
+        {
+            const std::string mask = write[1].matched ? write[1].str() : std::string("xyzw");
+            for (char c : mask)
+                sources[component(c)] = "?";
+        }
+    }
+
+    return true;
+}
+
+// SHADER_FLAG_POSITION_PASS_THROUGH / _XYZW_ / _XY01_: the position is (POSITION.xyz, 1), POSITION.xyzw or
+// (POSITION.xy, 0, 1), plus the half-pixel offset, so the renderer can work out from the vertices alone which
+// pixels a draw covers (while the clip plane is off): the exported register was written, in straight-line code,
+// only by the fetch of POSITION (with the same components) and by the constants, and nothing else writes the
+// position.
+void ShaderRecompiler::detectPositionPassThrough()
+{
+    positionFlags = 0;
+    texcoordPassThrough = false;
+
+    const std::vector<std::string> lines = splitLines(out);
+
+    // The body of main: after its signature and its opening brace.
+    size_t bodyStart = SIZE_MAX;
+    for (size_t i = 0; i < lines.size(); i++)
+    {
+        if (lines[i].rfind("Interpolators shaderMain(", 0) == 0)
+        {
+            for (size_t j = i + 1; j < lines.size(); j++)
+            {
+                if (lines[j] == "{")
+                {
+                    bodyStart = j + 1;
+                    break;
+                }
+            }
+            break;
+        }
+    }
+    if (bodyStart == SIZE_MAX)
+        return;
+
+    static const std::regex POSITION_OUTPUT(R"(^\toutput\.oPos\.xyzw = \(float4\)\(\((r\d+)\.xyzw\)\);$)");
+    size_t outputLine = SIZE_MAX;
+    std::string registerName;
+    for (size_t i = bodyStart; i < lines.size(); i++)
+    {
+        const std::string& line = lines[i];
+        if (line.find("oPos") == std::string::npos)
+            continue;
+
+        std::smatch match;
+        if (line == "\tif (g_ClipPlaneEnabled) output.clipDistance = dot(output.oPos, g_ClipPlane);" ||
+            line == "\toutput.oPos.xy += g_HalfPixelOffset * output.oPos.w;")
+        {
+            continue;
+        }
+        if (outputLine == SIZE_MAX && std::regex_match(line, match, POSITION_OUTPUT))
+        {
+            outputLine = i;
+            registerName = match[1].str();
+            continue;
+        }
+        return;
+    }
+
+    if (outputLine == SIZE_MAX)
+        return;
+
+    static const std::regex POSITION_FETCH(R"(^\t(r\d+)\.([xyzw]+) = \(float\d?\)\(\(input\.iPosition0\)\)\.([xyzw]+);$)");
+    std::string position[4];
+    if (!trackRegisterSources(lines, bodyStart, outputLine, registerName, POSITION_FETCH, position))
+        return;
+
+    const std::string sources = position[0] + position[1] + position[2] + position[3];
+    if (sources == "xyz1")
+        positionFlags = SHADER_FLAG_POSITION_PASS_THROUGH;
+    else if (sources == "xyzw")
+        positionFlags = SHADER_FLAG_POSITION_XYZW_PASS_THROUGH;
+    else if (sources == "xy01")
+        positionFlags = SHADER_FLAG_POSITION_XY01_PASS_THROUGH;
+    else
+        return;
+
+    // SHADER_FLAG_TEXCOORD_PASS_THROUGH: oTexCoord0.xy is written once (its z and w may come along), from two
+    // components of a register that straight-line code before left holding the x and y of the TEXCOORD0 input
+    // (swapFloats, which applies g_SwappedTexcoords). The other writes of oTexCoord0 are its zeroing at the start
+    // and the unused-component zeroing at the exits (never for components the pixel shader reads).
+    static const std::regex TEXCOORD_OUTPUT(R"(^\toutput\.oTexCoord0\.(xy[zw]{0,2}) = \(float(\d)\)\(\((r\d+)\.([xyzw]{2,4})\)\);$)");
+    size_t texcoordLine = SIZE_MAX;
+    std::string texcoordRegister;
+    std::string texcoordComponents;
+    for (size_t i = bodyStart; i < lines.size(); i++)
+    {
+        const std::string& line = lines[i];
+        if (line.find("oTexCoord0") == std::string::npos)
+            continue;
+
+        std::smatch match;
+        if (line == "\toutput.oTexCoord0 = 0.0;" || line.find("g_SpecUnusedOutputs") != std::string::npos)
+            continue;
+        if (texcoordLine == SIZE_MAX && std::regex_match(line, match, TEXCOORD_OUTPUT) &&
+            match[1].length() == match[4].length() && match[2].str() == std::to_string(match[1].length()))
+        {
+            texcoordLine = i;
+            texcoordRegister = match[3].str();
+            texcoordComponents = match[4].str();
+            continue;
+        }
+        return;
+    }
+
+    if (texcoordLine == SIZE_MAX)
+        return;
+
+    static const std::regex TEXCOORD_FETCH(R"(^\t(r\d+)\.([xyzw]+) = \(float\d?\)\(swapFloats\(g_SwappedTexcoords, \(input\.iTexCoord0\), 0\)\)\.([xyzw]+);$)");
+    std::string texcoord[4];
+    if (!trackRegisterSources(lines, bodyStart, texcoordLine, texcoordRegister, TEXCOORD_FETCH, texcoord))
+        return;
+
+    auto component = [](char c) { return c == 'x' ? 0 : c == 'y' ? 1 : c == 'z' ? 2 : 3; };
+    texcoordPassThrough = texcoord[component(texcoordComponents[0])] == "x" && texcoord[component(texcoordComponents[1])] == "y";
 }
+
+// SHADER_FLAG_PIXEL_COPY / SHADER_FLAG_DEPTH_COPY: the translated code of main (after the conditional rendering
+// prologue, up to the alpha test and the other endings every translated pixel shader has) is one of these, with
+// r0 holding TEXCOORD0 from the start and only the outputs it writes declared:
+//     rN.xyzw = tfetch2D(S..., r0.xy, float2(0, 0)).xyzw;  oC0.xyzw = (float4)((rN.xyzw));
+//     rN.x = tfetch2D(S..., r0.xy, float2(0, 0)).x;  ps = saturate((float)(rN.x));  oDepth = ps;
+//         [oC0.xyzw = (float4)((rN.xxxx));]  (required when oC0 is declared)
+// The slot is the one whose descriptor index S names.
+void ShaderRecompiler::detectCopyShader()
+{
+    copyFlags = 0;
+
+    const std::vector<std::string> lines = splitLines(out);
+
+    size_t bodyStart = SIZE_MAX;
+    bool texcoordInR0 = false;
+    for (size_t i = 0; i < lines.size(); i++)
+    {
+        if (lines[i] == "\tfloat4 r0 = input.iTexCoord0;")
+            texcoordInR0 = true;
+        else if (lines[i] == "\tbool gatherMismatch = false;")
+        {
+            bodyStart = i + 1;
+            break;
+        }
+    }
+    if (bodyStart == SIZE_MAX || !texcoordInR0)
+        return;
+
+    // One exit: the alpha test ends the body (with the gather verification output before it, if any).
+    size_t bodyEnd = SIZE_MAX;
+    for (size_t i = bodyStart; i < lines.size(); i++)
+    {
+        if (lines[i].find("SPEC_CONSTANT_ALPHA_TEST)") != std::string::npos)
+        {
+            if (bodyEnd != SIZE_MAX)
+                return;
+            bodyEnd = i;
+        }
+    }
+    if (bodyEnd == SIZE_MAX)
+        return;
+
+    // The verification output (printVerificationOutput) is not part of the copy.
+    if (bodyEnd >= bodyStart + 3 && lines[bodyEnd - 3] == "#ifdef __spirv__" &&
+        lines[bodyEnd - 2].find("gatherMismatch") != std::string::npos && lines[bodyEnd - 1] == "#endif")
+    {
+        bodyEnd -= 3;
+    }
+
+    std::vector<std::string> body;
+    for (size_t i = bodyStart; i < bodyEnd; i++)
+    {
+        if (!lines[i].empty())
+            body.push_back(lines[i]);
+    }
+
+    size_t next = 0;
+    std::smatch match;
+    static const std::regex FETCH(R"(^\t(r\d+)\.(xyzw|x) = tfetch2D\((\w+)_Texture2DDescriptorIndex, (\w+)_SamplerDescriptorIndex, r0\.xy, float2\(0, 0\)\)\.(xyzw|x);$)");
+    if (next >= body.size() || !std::regex_match(body[next], match, FETCH) || match[2].str() != match[5].str() ||
+        match[3].str() != match[4].str())
+    {
+        return;
+    }
+
+    const std::string fetched = match[1].str();
+    const bool wholeTexel = match[2].str() == "xyzw";
+    const std::string sampler = match[3].str();
+    next++;
+
+    uint32_t flag = 0;
+    if (wholeTexel)
+    {
+        if (pixelShaderOutputs == PIXEL_SHADER_OUTPUT_COLOR0 && next < body.size() &&
+            body[next] == "\toC0.xyzw = (float4)((" + fetched + ".xyzw));")
+        {
+            next++;
+            flag = SHADER_FLAG_PIXEL_COPY;
+        }
+    }
+    else if ((pixelShaderOutputs & ~(PIXEL_SHADER_OUTPUT_COLOR0 | PIXEL_SHADER_OUTPUT_DEPTH)) == 0 &&
+        (pixelShaderOutputs & PIXEL_SHADER_OUTPUT_DEPTH) != 0 && next + 1 < body.size() &&
+        body[next] == "\tps = saturate((float)(" + fetched + ".x));" && body[next + 1] == "\toDepth = ps;")
+    {
+        next += 2;
+        if (next < body.size() && body[next] == "\toC0.xyzw = (float4)((" + fetched + ".xxxx));")
+            next++;
+        else if ((pixelShaderOutputs & PIXEL_SHADER_OUTPUT_COLOR0) != 0)
+            return;
+        flag = SHADER_FLAG_DEPTH_COPY;
+    }
+
+    if (flag == 0 || next != body.size())
+        return;
+
+    // The slot: "#define S_Texture2DDescriptorIndex (UR_CONSTANTS_UBO ? UR_SHARED_UINT(4 * slot) : ...".
+    const std::regex DEFINE("^#define " + sampler + R"(_Texture2DDescriptorIndex \(UR_CONSTANTS_UBO \? UR_SHARED_UINT\((\d+)\))");
+    for (const auto& line : lines)
+    {
+        if (std::regex_search(line, match, DEFINE))
+        {
+            const uint32_t offset = uint32_t(std::stoul(match[1].str()));
+            if ((offset % 4) == 0 && offset / 4 <= SHADER_FLAG_COPY_SLOT_MASK)
+                copyFlags = flag | ((offset / 4) << SHADER_FLAG_COPY_SLOT_SHIFT);
+            return;
+        }
+    }
+}
+
+static std::string joinLines(const std::vector<std::string>& lines)
+{
+    std::string text;
+    for (size_t i = 0; i < lines.size(); i++)
+    {
+        text += lines[i];
+        if (i + 1 < lines.size())
+            text += '\n';
+    }
+    return text;
+}
+
+// SPEC_CONSTANT_TEXTURE_SIZE: the size arguments of the fetches. Vulkan reads the shared constants' tables (dynamic
+// UBO or pointer, like every shared constant; the block is 256-byte aligned); D3D12 and Metal ignore the argument.
+// A shader that reads the tables declares the whole shared block: UR_SHARED_CONSTANTS_TABLES, before the header.
+void ShaderRecompiler::printTextureSizeDefines()
+{
+    if (textureSizes2D.empty() && textureSizes2DArray.empty())
+        return;
+
+    std::string defines = "#ifdef __spirv__\n";
+    for (const auto& [name, slot] : textureSizes2D)
+    {
+        const uint32_t offset = SHARED_CONSTANTS_TEXTURE_2D_SIZES_OFFSET + slot * 8;
+        defines += fmt::format("#define {}_Texture2DSize (UR_CONSTANTS_UBO ? float2(UR_SHARED_FLOAT({}), UR_SHARED_FLOAT({})) : vk::RawBufferLoad<float2>(g_PushConstants.SharedConstants + {}, 0x8))\n",
+            name, offset, offset + 4, offset);
+    }
+    for (const auto& [name, slot] : textureSizes2DArray)
+    {
+        const uint32_t offset = SHARED_CONSTANTS_TEXTURE_2D_ARRAY_SIZES_OFFSET + slot * 16;
+        defines += fmt::format("#define {}_Texture2DArraySize (UR_CONSTANTS_UBO ? g_UboShared.v[{}] : vk::RawBufferLoad<float4>(g_PushConstants.SharedConstants + {}, 0x10))\n",
+            name, offset / 16, offset);
+    }
+    defines += "#else\n";
+    for (const auto& [name, slot] : textureSizes2D)
+        defines += fmt::format("#define {}_Texture2DSize float2(0.0, 0.0)\n", name);
+    for (const auto& [name, slot] : textureSizes2DArray)
+        defines += fmt::format("#define {}_Texture2DArraySize float4(0.0, 0.0, 0.0, 0.0)\n", name);
+    defines += "#endif\n";
+
+    out.insert(textureSizeDefinesPosition, defines);
+    out.insert(0, "#define UR_SHARED_CONSTANTS_TABLES\n");
+}
+
+// The cascaded shadow maps' manual PCF, four consecutive lines
+//     rN.m = tfetch2DArray(S_Texture2DArrayDescriptorIndex, S_SamplerDescriptorIndex, rC.abc, float3(X, Y, 0), S_Texture2DArraySize).x;
+// of one sampler, one coordinate and one indentation, with the offsets (X, Y) = (+-0.5, +-0.5) texels in any order.
+// Consecutive lines with nothing in between (no brace, no case label) run one after the other under the same
+// predicate, even when they came from two exec clauses. No fetch before the last may write a component of the
+// coordinate, and every written component comes from the red channel. The rewrite runs one gather instead where
+// that returns the same texels (SPEC_CONSTANT_SHADOW_GATHER), the four fetches otherwise; either way the registers
+// are written in the original order.
+uint32_t ShaderRecompiler::rewriteShadowFetches()
+{
+    if (textureSizes2DArray.empty())
+        return 0;
+
+    static const std::regex FETCH_LINE(
+        R"(^(\t*)r(\d+)\.([xyzw]+) = tfetch2DArray\((\w+)_Texture2DArrayDescriptorIndex, \4_SamplerDescriptorIndex, r(\d+)\.([xyzw]{3}), float3\((-?[0-9.]+), (-?[0-9.]+), 0\), \4_Texture2DArraySize\)\.(x+);$)");
+
+    struct Fetch
+    {
+        std::string indentation;
+        std::string dstRegister;
+        std::string dstComponents;
+        std::string name;
+        std::string srcRegister;
+        std::string srcComponents;
+        std::string offsetXText;
+        std::string offsetYText;
+        char component = 0; // The gather's component that holds this fetch's texel.
+    };
+
+    const std::vector<std::string> lines = splitLines(out);
+    std::vector<std::optional<Fetch>> fetches(lines.size());
+    for (size_t i = 0; i < lines.size(); i++)
+    {
+        std::smatch match;
+        if (!std::regex_match(lines[i], match, FETCH_LINE) || match[9].length() != match[3].length())
+            continue;
+
+        Fetch fetch;
+        fetch.indentation = match[1];
+        fetch.dstRegister = match[2];
+        fetch.dstComponents = match[3];
+        fetch.name = match[4];
+        fetch.srcRegister = match[5];
+        fetch.srcComponents = match[6];
+        fetch.offsetXText = match[7];
+        fetch.offsetYText = match[8];
+
+        // Half texels. Gather order: x = (i0, j1), y = (i1, j1), z = (i1, j0), w = (i0, j0), where i0/j0 are the texels
+        // half a texel left of / above the coordinate and i1/j1 those half a texel right of / below it.
+        const long offsetX = std::lround(std::stod(fetch.offsetXText) * 2.0);
+        const long offsetY = std::lround(std::stod(fetch.offsetYText) * 2.0);
+        if ((offsetX != -1 && offsetX != 1) || (offsetY != -1 && offsetY != 1) ||
+            std::stod(fetch.offsetXText) * 2.0 != double(offsetX) || std::stod(fetch.offsetYText) * 2.0 != double(offsetY))
+        {
+            continue;
+        }
+
+        if (offsetY < 0)
+            fetch.component = offsetX < 0 ? 'w' : 'z';
+        else
+            fetch.component = offsetX < 0 ? 'x' : 'y';
+
+        fetches[i] = std::move(fetch);
+    }
+
+    auto slotOf = [&](const std::string& name) -> int32_t
+        {
+            for (auto& [registerIndex, samplerName] : samplers)
+            {
+                if (name == samplerName)
+                    return int32_t(registerIndex);
+            }
+            return -1;
+        };
+
+    std::vector<std::string> result;
+    result.reserve(lines.size() + 64);
+    uint32_t rewritten = 0;
+
+    for (size_t i = 0; i < lines.size();)
+    {
+        bool matches = i + 4 <= lines.size();
+        int32_t slot = -1;
+        if (matches)
+        {
+            const auto& head = fetches[i];
+            slot = head ? slotOf(head->name) : -1;
+            matches = slot >= 0 && slot < 16;
+
+            // Each of the four taps once.
+            bool seen[4]{};
+            for (size_t j = 0; matches && j < 4; j++)
+            {
+                const auto& fetch = fetches[i + j];
+                const size_t tap = fetch ? size_t(strchr("xyzw", fetch->component) - "xyzw") : 0;
+                if (!fetch || fetch->indentation != head->indentation || fetch->name != head->name ||
+                    fetch->srcRegister != head->srcRegister || fetch->srcComponents != head->srcComponents || seen[tap])
+                {
+                    matches = false;
+                    break;
+                }
+                seen[tap] = true;
+
+                // The coordinate must be the same for every fetch: only the last may write it.
+                if (j < 3 && fetch->dstRegister == head->srcRegister &&
+                    fetch->dstComponents.find_first_of(head->srcComponents) != std::string::npos)
+                {
+                    matches = false;
+                }
+            }
+        }
+
+        if (!matches)
+        {
+            result.push_back(lines[i]);
+            i++;
+            continue;
+        }
+
+        const Fetch& head = *fetches[i];
+        const std::string& tab = head.indentation;
+        const std::string coordinate = fmt::format("r{}.{}", head.srcRegister, head.srcComponents);
+        const uint32_t id = rewritten++;
+        gatherSlots |= 1u << slot;
+
+        result.push_back("#ifdef __spirv__");
+        result.push_back(fmt::format("{}[branch] if ((g_SpecConstants() & SPEC_CONSTANT_SHADOW_GATHER) != 0 && "
+            "((g_SpecConstants() & SPEC_CONSTANT_SHADOW_GATHER_KNOWN) != 0 || (g_GatherableSlots & (1u << {})) != 0) && "
+            "tfetch2DArrayGatherExact({}_Texture2DArrayDescriptorIndex, {}, {}_Texture2DArraySize))", tab, slot, head.name, coordinate, head.name));
+        result.push_back(tab + "{");
+        result.push_back(fmt::format("{0}\tfloat4 gather{1}_0 = tfetch2DArrayGather({2}_Texture2DArrayDescriptorIndex, {2}_SamplerDescriptorIndex, {3}, {2}_Texture2DArraySize);",
+            tab, id, head.name, coordinate));
+        result.push_back(tab + "\t[branch] if (g_SpecConstants() & SPEC_CONSTANT_SHADOW_GATHER_VERIFY)");
+        result.push_back(tab + "\t{");
+        for (size_t j = 0; j < 4; j++)
+        {
+            const Fetch& fetch = *fetches[i + j];
+            result.push_back(fmt::format("{0}\t\tif (asuint(tfetch2DArray({1}_Texture2DArrayDescriptorIndex, {1}_SamplerDescriptorIndex, {2}, float3({3}, {4}, 0), {1}_Texture2DArraySize).x) != asuint(gather{5}_0.{6})) gatherMismatch = true;",
+                tab, fetch.name, coordinate, fetch.offsetXText, fetch.offsetYText, id, fetch.component));
+        }
+        result.push_back(tab + "\t}");
+        for (size_t j = 0; j < 4; j++)
+        {
+            const Fetch& fetch = *fetches[i + j];
+            result.push_back(fmt::format("{}\tr{}.{} = gather{}_0.{};", tab, fetch.dstRegister, fetch.dstComponents, id,
+                std::string(fetch.dstComponents.size(), fetch.component)));
+        }
+        result.push_back(tab + "}");
+        result.push_back(tab + "else");
+        result.push_back("#endif");
+        result.push_back(tab + "{");
+        for (size_t j = 0; j < 4; j++)
+            result.push_back('\t' + lines[i + j]);
+        result.push_back(tab + "}");
+
+        i += 4;
+    }
+
+    if (rewritten != 0)
+        out = joinLines(result);
+
+    return rewritten;
+}
+
+void ShaderRecompiler::printVerificationOutput()
+{
+    // Only shaders with sized fetches can find a mismatch (every gather rewrite is one of them).
+    if ((textureSizes2D.empty() && textureSizes2DArray.empty()) || (pixelShaderOutputs & PIXEL_SHADER_OUTPUT_COLOR0) == 0)
+        return;
+
+    // Before the alpha test, so that a verification failure is never clipped away.
+    std::vector<std::string> lines = splitLines(out);
+    std::vector<std::string> result;
+    result.reserve(lines.size() + 8);
+    for (const auto& line : lines)
+    {
+        const size_t tabs = line.find_first_not_of('\t');
+        if (tabs != std::string::npos && std::string_view(line).substr(tabs) == ALPHA_TEST_LINE)
+        {
+            result.push_back("#ifdef __spirv__");
+            result.push_back(line.substr(0, tabs) + "if (gatherMismatch || g_TextureSizeMismatch) oC0 = float4(1.0, 0.0, 1.0, 1.0);");
+            result.push_back("#endif");
+        }
+        result.push_back(line);
+    }
+
+    out = joinLines(result);
+}
+
+void ShaderRecompiler::printBlendSkip()
+{
+    if ((pixelShaderOutputs & PIXEL_SHADER_OUTPUT_COLOR0) == 0)
+        return;
+
+    // After the alpha test (a pixel it keeps may still change nothing), before the unused colour channels are
+    // zeroed: the blend reads the alpha the shader wrote, and _ZERO all four channels. Vulkan only.
+    specConstantsMask |= SPEC_CONSTANT_BLEND_SKIP_ALPHA | SPEC_CONSTANT_BLEND_SKIP_ZERO;
+    out += "#ifdef __spirv__\n";
+    indent();
+    out += "if ((g_SpecConstants() & SPEC_CONSTANT_BLEND_SKIP_ALPHA) != 0 && oC0.w <= 0.0) discard;\n";
+    indent();
+    out += "if ((g_SpecConstants() & SPEC_CONSTANT_BLEND_SKIP_ZERO) != 0 && all(oC0 <= 0.0)) discard;\n";
+    out += "#endif\n";
+}
+
+// The branch of rewriteAlphaTestEarlyOut. The pixels it skips are discarded at the end: by the alpha test (the
+// same comparison as the clip, so a NaN alpha, kept by the clip, also runs the code) or by the blend skip
+// (SPEC_CONSTANT_BLEND_SKIP_ALPHA, the same comparison as its discard).
+static constexpr std::string_view ALPHA_TEST_EARLY_OUT_BRANCH =
+    "\t[branch] if (((g_SpecConstants() & (SPEC_CONSTANT_ALPHA_TEST | SPEC_CONSTANT_ALPHA_TEST_EARLY_OUT)) != "
+    "(SPEC_CONSTANT_ALPHA_TEST | SPEC_CONSTANT_ALPHA_TEST_EARLY_OUT) || !((oC0.w - g_AlphaThreshold) < 0.0)) && "
+    "((g_SpecConstants() & SPEC_CONSTANT_BLEND_SKIP_ALPHA) == 0 || !(oC0.w <= 0.0)))";
+
+static std::string trimmed(const std::string& line)
+{
+    size_t first = line.find_first_not_of(" \t");
+    return first == std::string::npos ? std::string() : line.substr(first);
+}
+
+// Whether a line assigns to oC0, and to its w: 0 no, 1 yes without w, 2 yes with w; -1 a mention of oC0 that is
+// neither a plain read nor an assignment this recognises.
+static int colourWrite(const std::string& line)
+{
+    if (line.find("oC0") == std::string::npos)
+        return 0;
+
+    const std::string text = trimmed(line);
+    if (text.rfind("oC0", 0) == 0)
+    {
+        size_t position = 3;
+        bool hasW = true;
+        if (position < text.size() && text[position] == '.')
+        {
+            size_t maskEnd = position + 1;
+            while (maskEnd < text.size() && strchr("xyzw", text[maskEnd]) != nullptr)
+                maskEnd++;
+            if (maskEnd == position + 1)
+                return -1;
+            hasW = text.find('w', position + 1) < maskEnd;
+            position = maskEnd;
+        }
+
+        while (position < text.size() && text[position] == ' ')
+            position++;
+        if (position < text.size() && strchr("+-*/", text[position]) != nullptr)
+            position++;
+
+        if (position + 1 < text.size() && text[position] == '=' && text[position + 1] != '=')
+            return hasW ? 2 : 1;
+        return -1;
+    }
+
+    // oC0 elsewhere: a read on the right-hand side of the line's one plain assignment.
+    const size_t mention = line.find("oC0");
+    const size_t assignment = line.find(" = ");
+    if (assignment != std::string::npos && assignment < mention && line.find(" = ", assignment + 1) == std::string::npos)
+        return 0;
+    return -1;
+}
+
+// The pixel shader's one exit (a single alpha test, at the top level of main): the lines between the last write of
+// oC0.w and the alpha test go into ALPHA_TEST_EARLY_OUT_BRANCH (Vulkan only; the other backends see a plain block).
+//
+// oC0 is the only name the translated code writes the colour output by (a macro for output.oC0, stage 1), so a line
+// writes oC0.w exactly when it assigns to oC0 with no mask or a mask with w. The search stops at the first such line
+// before the test; any other form of write to oC0, or any mention of output., in between gives up, so a write the
+// parser does not recognise can never end up inside the branch (where the test would read a stale alpha).
+bool ShaderRecompiler::rewriteAlphaTestEarlyOut(bool& shortRegion)
+{
+    if ((pixelShaderOutputs & PIXEL_SHADER_OUTPUT_COLOR0) == 0)
+        return false;
+
+    std::vector<std::string> lines = splitLines(out);
+
+    // The translated code: after the conditional rendering prologue (and the header, whose Metal part defines clip).
+    size_t bodyStart = SIZE_MAX;
+    for (size_t i = 0; i < lines.size(); i++)
+    {
+        if (lines[i] == "\tbool gatherMismatch = false;")
+        {
+            bodyStart = i + 1;
+            break;
+        }
+    }
+    if (bodyStart == SIZE_MAX)
+        return false;
+
+    // One exit, hence one alpha test, not nested in any block.
+    size_t testLine = SIZE_MAX;
+    for (size_t i = bodyStart; i < lines.size(); i++)
+    {
+        if (lines[i].find("clip(") != std::string::npos)
+        {
+            if (testLine != SIZE_MAX)
+                return false;
+            testLine = i;
+        }
+    }
+
+    if (testLine == SIZE_MAX || lines[testLine] != "\t" + std::string(ALPHA_TEST_LINE))
+        return false;
+
+    // The verification output stays outside, so that it still shows on every pixel.
+    size_t regionEnd = testLine;
+    if (regionEnd >= 3 && lines[regionEnd - 1] == "#endif" &&
+        lines[regionEnd - 2].find("gatherMismatch") != std::string::npos && lines[regionEnd - 3] == "#ifdef __spirv__")
+    {
+        regionEnd -= 3;
+    }
+
+    size_t regionStart = SIZE_MAX;
+    for (size_t i = regionEnd; i-- > bodyStart;)
+    {
+        if (lines[i].find("output.") != std::string::npos)
+            return false;
+
+        const int write = colourWrite(lines[i]);
+        if (write < 0)
+            return false;
+        if (write == 2)
+        {
+            regionStart = i + 1;
+            break;
+        }
+    }
+
+    if (regionStart == SIZE_MAX || regionEnd <= regionStart)
+        return false;
+
+    // Alpha written late: the branch skips little. The caller undoes the rewrite (until something moves into it).
+    shortRegion = regionEnd - regionStart < 16;
+
+    // Straight arithmetic only: nothing that needs the neighbouring pixels (texture fetches with an implicit level of
+    // detail, tfetch2DArray included, weights, derivatives), no other exit, no loop, no state machine jump, no
+    // preprocessor line, nothing unbalanced.
+    static constexpr const char* FORBIDDEN[] =
+    {
+        "tfetch", "getWeights", "getPixelCoord", "computeMipLevel", "ddx", "ddy", "fwidth", "Sample", "Gather",
+        "Load(", "texture", "clip(", "discard", "return", "for (", "for(", "while", "switch", "case ", "break",
+        "continue", "pc = ", "gatherMismatch", "#", "atomic", "g_ConditionalSurveyBuffer",
+    };
+
+    int depth = 0;
+    for (size_t i = regionStart; i < regionEnd; i++)
+    {
+        const std::string& line = lines[i];
+        for (const char* token : FORBIDDEN)
+        {
+            if (line.find(token) != std::string::npos)
+                return false;
+        }
+
+        if (trimmed(line) == "do")
+            return false;
+
+        for (char c : line)
+        {
+            if (c == '{')
+                depth++;
+            else if (c == '}' && --depth < 0)
+                return false;
+        }
+    }
+
+    if (depth != 0)
+        return false;
+
+    lines.insert(lines.begin() + regionEnd, "\t}");
+    lines.insert(lines.begin() + regionStart, "\t{");
+    lines.insert(lines.begin() + regionStart, "#endif");
+    lines.insert(lines.begin() + regionStart, std::string(ALPHA_TEST_EARLY_OUT_BRANCH));
+    lines.insert(lines.begin() + regionStart, "#ifdef __spirv__");
+
+    out = joinLines(lines);
+    specConstantsMask |= SPEC_CONSTANT_ALPHA_TEST_EARLY_OUT;
+    return true;
+}
+
+
+// SPEC_CONSTANT_ALPHA_TEST_SINK: the alpha-test sinking of UnleashedRecomp-NX (its per-pixel variant; the quad
+// variant, slower there, is not ported), on Marathon's text.
+namespace
+{
+    // The components a statement writes or reads, per variable ("r12", "oC0", "ps", "_t3"...): x, y, z, w are
+    // bits 0-3; scalars use bit 0.
+    using ComponentSets = std::map<std::string, uint32_t>;
+
+    uint32_t componentMask(std::string_view swizzle)
+    {
+        if (swizzle.empty())
+            return 0xF;
+
+        uint32_t mask = 0;
+        for (char c : swizzle)
+        {
+            if (c == 'x') mask |= 1;
+            else if (c == 'y') mask |= 2;
+            else if (c == 'z') mask |= 4;
+            else if (c == 'w') mask |= 8;
+        }
+        return mask;
+    }
+
+    bool overlaps(const ComponentSets& a, const ComponentSets& b)
+    {
+        for (const auto& [name, mask] : a)
+        {
+            auto found = b.find(name);
+            if (found != b.end() && (found->second & mask) != 0)
+                return true;
+        }
+        return false;
+    }
+
+    void addComponents(ComponentSets& to, const ComponentSets& from)
+    {
+        for (const auto& [name, mask] : from)
+            to[name] |= mask;
+    }
+
+    void removeComponents(ComponentSets& from, const ComponentSets& what)
+    {
+        for (const auto& [name, mask] : what)
+        {
+            auto found = from.find(name);
+            if (found != from.end() && (found->second &= ~mask) == 0)
+                from.erase(found);
+        }
+    }
+
+    // The registers and variables translated code reads and writes (oC0-oC3 and oDepth are the macros for the
+    // outputs, so every write of an output is seen), and the sinking's own temporaries (_tN, each written once).
+    // Constants (cN, g_..., c_...) and the interpolators never change; locals declared inside a block (gather0_0)
+    // stay in it.
+    const std::regex& variableReference()
+    {
+        static const std::regex REFERENCE(R"(\b(r\d+|oC[0-3]|oDepth|ps|p0|_t\d+)\b(?:\.([xyzw]{1,4})\b)?)");
+        return REFERENCE;
+    }
+
+    const std::regex& assignment()
+    {
+        static const std::regex ASSIGNMENT(R"((?:^|[\s{};])(r\d+|oC[0-3]|oDepth|ps|p0|_t\d+)(?:\.([xyzw]{1,4}))?\s*([-+*/]?=)(?!=))");
+        return ASSIGNMENT;
+    }
+
+    struct SinkUnit
+    {
+        std::vector<std::string> lines;
+        ComponentSets uses;
+        ComponentSets mayDefs;
+        ComponentSets mustDefs;
+        bool pinned = false;         // must run where it is: other exits, the state machine, address registers, cube maps
+        bool derivatives = false;    // implicit level of detail or derivatives: needs its whole 2x2 quad
+        bool gatherPath = false;     // the gather half of a split shadow filter
+        bool copy = false;           // a copy of a renamed value back into its register
+        size_t construct = SIZE_MAX; // index of the original gather construct (both halves)
+        size_t origin = SIZE_MAX;    // the line of the translated code it comes from
+    };
+
+    void analyseUnit(SinkUnit& unit)
+    {
+        unit.uses.clear();
+        unit.mayDefs.clear();
+        unit.mustDefs.clear();
+        unit.pinned = false;
+        unit.derivatives = false;
+
+        std::string text;
+        for (const auto& line : unit.lines)
+        {
+            // The gather verification (SPEC_CONSTANT_SHADOW_GATHER_VERIFY) compares with point fetches; the sunk
+            // variant never runs with it (UR_ALPHA_TEST_SINK), so those fetches do not keep the unit in place.
+            if (line.find("gatherMismatch = true") != std::string::npos)
+                continue;
+            text += line;
+            text += '\n';
+        }
+
+        // Undefined in a branch that some pixels of a 2x2 quad skip: fetches with an implicit level of detail and
+        // derivatives. tfetch2DArray (the shadow maps' point fetches, and the s0 fetch whose SetTextureLod the
+        // translator ignores is a tfetch2D) included; getWeights stays with them. The gathers (tfetch2DArrayGather,
+        // tfetch2DArrayGatherExact: no level of detail) may move.
+        static constexpr const char* DERIVATIVES[] =
+        {
+            "tfetch2D(", "tfetch2DArray(", "tfetch2DBicubic(", "tfetch3D(", "tfetch1D(", "getWeights", "getPixelCoord",
+            "computeMipLevel", ".Sample", "ddx", "ddy", "fwidth",
+        };
+        for (const char* token : DERIVATIVES)
+        {
+            if (text.find(token) != std::string::npos)
+                unit.derivatives = true;
+        }
+
+        // Never moved: other exits, loops, the state machine, atomics, cube maps (tfetchCube is also a fetch with
+        // an implicit level of detail).
+        static constexpr const char* PINNING[] =
+        {
+            "tfetchCube(", "cube(", "clip(", "discard", "return", "for (", "for(", "while", "switch", "case ", "break",
+            "continue", "pc = ", "atomic", "g_ConditionalSurveyBuffer", "output.",
+        };
+        for (const char* token : PINNING)
+        {
+            if (text.find(token) != std::string::npos)
+                unit.pinned = true;
+        }
+
+        static const std::regex ADDRESS(R"(\b(a0|aL)\b)");
+        if (std::regex_search(text, ADDRESS))
+            unit.pinned = true;
+
+        for (const auto& line : unit.lines)
+        {
+            const std::string text = trimmed(line);
+            if (!text.empty() && text[0] == '#' && !unit.gatherPath)
+                unit.pinned = true;
+        }
+
+        const bool compound = text.find('{') != std::string::npos || text.find("if (") != std::string::npos;
+
+        // Left-hand sides of plain assignments are not reads.
+        std::vector<std::pair<size_t, size_t>> writes;
+        for (auto it = std::sregex_iterator(text.begin(), text.end(), assignment()); it != std::sregex_iterator(); ++it)
+        {
+            const auto& match = *it;
+            const uint32_t mask = componentMask(match[2].matched ? match[2].str() : std::string());
+            unit.mayDefs[match[1].str()] |= mask;
+            if (!compound)
+                unit.mustDefs[match[1].str()] |= mask;
+
+            if (match[3].str() == "=")
+                writes.emplace_back(size_t(match.position(1)), size_t(match.position(1) + match[1].length() + (match[2].matched ? match[2].length() + 1 : 0)));
+            else
+                unit.uses[match[1].str()] |= mask;
+        }
+
+        for (auto it = std::sregex_iterator(text.begin(), text.end(), variableReference()); it != std::sregex_iterator(); ++it)
+        {
+            const auto& match = *it;
+            const size_t position = size_t(match.position(0));
+            bool written = false;
+            for (const auto& [start, end] : writes)
+            {
+                if (position >= start && position < end)
+                    written = true;
+            }
+
+            if (!written)
+            {
+                const uint32_t mask = componentMask(match[2].matched ? match[2].str() : std::string());
+                unit.uses[match[1].str()] |= mask;
+            }
+        }
+    }
+
+    // The right-hand side of a translated statement as a tree, to write one of its components on its own
+    // (SinkRenamer::SplitComponents). Only what the ALU translation produces is understood: numbers, registers,
+    // constants and temporaries with or without a swizzle, the constant arrays' accessors (g_..., c_...) with one,
+    // floatN(...) constructors, (floatN)(...) casts, unary minus, + - * /, comparisons, ?: and the component-wise
+    // intrinsics (selectWrapper among them); dot and the like give a scalar. Anything else makes the parse fail, and
+    // the statement stays whole.
+    struct SplitNode
+    {
+        enum class Kind { NUMBER, VARIABLE, ATOM, CONSTRUCTOR, CAST, UNARY, BINARY, TERNARY, CALL, SWIZZLE };
+
+        Kind kind = Kind::NUMBER;
+        std::string text;    // the number, variable name, whole accessor text, type, operator or function name
+        std::string swizzle; // VARIABLE, ATOM and SWIZZLE
+        std::vector<std::unique_ptr<SplitNode>> children;
+        uint32_t width = 0;  // components; 1 is a scalar, which HLSL broadcasts
+        bool componentwise = true; // CALL: per component; false: a scalar result (dot, length...)
+    };
+
+    class SplitParser
+    {
+    public:
+        SplitParser(const std::string& text, const std::map<std::string, uint32_t>& temporaryWidths)
+            : text(text), temporaryWidths(temporaryWidths)
+        {
+        }
+
+        std::unique_ptr<SplitNode> Parse()
+        {
+            auto node = ParseTernary();
+            SkipSpaces();
+            if (node == nullptr || position != text.size())
+                return nullptr;
+            return node;
+        }
+
+    private:
+        const std::string& text;
+        const std::map<std::string, uint32_t>& temporaryWidths;
+        size_t position = 0;
+
+        void SkipSpaces()
+        {
+            while (position < text.size() && isspace(uint8_t(text[position])))
+                position++;
+        }
+
+        bool Accept(std::string_view token)
+        {
+            SkipSpaces();
+            if (text.compare(position, token.size(), token) == 0)
+            {
+                // "=" must not take the first half of "==", nor "<" of "<=".
+                const size_t end = position + token.size();
+                if ((token == "<" || token == ">" || token == "=") && end < text.size() && text[end] == '=')
+                    return false;
+                position = end;
+                return true;
+            }
+            return false;
+        }
+
+        static uint32_t ComponentIndex(char c)
+        {
+            switch (c)
+            {
+            case 'x': return 0;
+            case 'y': return 1;
+            case 'z': return 2;
+            case 'w': return 3;
+            default: return 4;
+            }
+        }
+
+        static bool IsSwizzle(const std::string& s)
+        {
+            if (s.empty() || s.size() > 4)
+                return false;
+            for (char c : s)
+            {
+                if (ComponentIndex(c) == 4)
+                    return false;
+            }
+            return true;
+        }
+
+        std::string ParseIdentifier()
+        {
+            SkipSpaces();
+            const size_t start = position;
+            while (position < text.size() && (isalnum(uint8_t(text[position])) || text[position] == '_'))
+                position++;
+            return text.substr(start, position - start);
+        }
+
+        uint32_t VariableWidth(const std::string& name) const
+        {
+            static const std::regex REGISTER(R"(^([rc]\d+|oC[0-3])$)");
+            if (std::regex_match(name, REGISTER))
+                return 4;
+            if (name == "ps" || name == "p0" || name == "oDepth" || name == "FLT_MIN" || name == "FLT_MAX")
+                return 1;
+            auto found = temporaryWidths.find(name);
+            return found != temporaryWidths.end() ? found->second : 0;
+        }
+
+        static bool IsComponentwise(const std::string& name)
+        {
+            static const std::set<std::string> NAMES =
+            {
+                "saturate", "abs", "rcp", "rsqrt", "sqrt", "log2", "exp2", "frac", "floor", "ceil", "trunc", "round",
+                "sign", "min", "max", "clamp", "select", "selectWrapper", "isnan", "isinf", "asfloat", "asuint", "asint",
+                "sin", "cos",
+            };
+            return NAMES.count(name) != 0;
+        }
+
+        static bool IsScalarResult(const std::string& name)
+        {
+            return name == "dot" || name == "length" || name == "distance" || name == "any" || name == "all";
+        }
+
+        // float, float2... int, uint, bool: the scalar type and the width (1 without a number).
+        static bool ParseType(const std::string& name, uint32_t& width)
+        {
+            static const std::regex TYPE(R"(^(float|bool|int|uint)([1-4]?)$)");
+            std::smatch match;
+            if (!std::regex_match(name, match, TYPE))
+                return false;
+            width = match[2].length() != 0 ? uint32_t(std::stoi(match[2].str())) : 1;
+            return true;
+        }
+
+        std::unique_ptr<SplitNode> ParsePostfix(std::unique_ptr<SplitNode> node)
+        {
+            SkipSpaces();
+            if (position < text.size() && text[position] == '.' && position + 1 < text.size() && isalpha(uint8_t(text[position + 1])))
+            {
+                const size_t save = position;
+                position++;
+                const std::string swizzle = ParseIdentifier();
+                if (!IsSwizzle(swizzle))
+                {
+                    position = save;
+                    return node;
+                }
+
+                if (node->kind == SplitNode::Kind::VARIABLE || node->kind == SplitNode::Kind::ATOM)
+                {
+                    if (!node->swizzle.empty())
+                        return nullptr;
+                    node->swizzle = swizzle;
+                    node->width = uint32_t(swizzle.size());
+                    return node;
+                }
+
+                auto result = std::make_unique<SplitNode>();
+                result->kind = SplitNode::Kind::SWIZZLE;
+                result->swizzle = swizzle;
+                result->width = uint32_t(swizzle.size());
+                for (char c : swizzle)
+                {
+                    if (node->width != 1 && ComponentIndex(c) >= node->width)
+                        return nullptr;
+                }
+                result->children.push_back(std::move(node));
+                return result;
+            }
+            return node;
+        }
+
+        std::unique_ptr<SplitNode> ParsePrimary()
+        {
+            SkipSpaces();
+            if (position >= text.size())
+                return nullptr;
+
+            const char c = text[position];
+            if (c == '(')
+            {
+                position++;
+
+                // Marathon's casts, "(float3)(...)": a type name alone in parentheses, then the operand. As in HLSL,
+                // a cast of several components to fewer keeps the first ones, and a scalar is broadcast.
+                const size_t save = position;
+                uint32_t castWidth = 0;
+                const std::string type = ParseIdentifier();
+                if (ParseType(type, castWidth) && Accept(")"))
+                {
+                    auto operand = ParseUnary();
+                    if (operand == nullptr || operand->width == 0 || (operand->width != 1 && operand->width < castWidth))
+                        return nullptr;
+
+                    auto node = std::make_unique<SplitNode>();
+                    node->kind = SplitNode::Kind::CAST;
+                    node->text = type;
+                    node->width = castWidth;
+                    node->children.push_back(std::move(operand));
+                    return node;
+                }
+                position = save;
+
+                auto inner = ParseTernary();
+                if (inner == nullptr || !Accept(")"))
+                    return nullptr;
+                return ParsePostfix(std::move(inner));
+            }
+
+            if (isdigit(uint8_t(c)) || (c == '.' && position + 1 < text.size() && isdigit(uint8_t(text[position + 1]))))
+            {
+                const size_t start = position;
+                while (position < text.size() && (isdigit(uint8_t(text[position])) || text[position] == '.'))
+                    position++;
+                if (position < text.size() && (text[position] == 'e' || text[position] == 'E'))
+                {
+                    position++;
+                    if (position < text.size() && (text[position] == '+' || text[position] == '-'))
+                        position++;
+                    while (position < text.size() && isdigit(uint8_t(text[position])))
+                        position++;
+                }
+                if (position < text.size() && (text[position] == 'f' || text[position] == 'u'))
+                    position++;
+
+                auto node = std::make_unique<SplitNode>();
+                node->kind = SplitNode::Kind::NUMBER;
+                node->text = text.substr(start, position - start);
+                node->width = 1;
+                return node;
+            }
+
+            if (!isalpha(uint8_t(c)) && c != '_')
+                return nullptr;
+
+            const size_t start = position;
+            const std::string name = ParseIdentifier();
+            SkipSpaces();
+            if (position < text.size() && text[position] == '(')
+            {
+                // A constant array's accessor (the translator's macros g_Name(INDEX) and c_name(INDEX)): kept as
+                // written, with the swizzle it must have.
+                if (name.rfind("g_", 0) == 0 || name.rfind("c_", 0) == 0 || name.rfind("mrg", 0) == 0)
+                {
+                    int depth = 0;
+                    for (; position < text.size(); position++)
+                    {
+                        if (text[position] == '(')
+                            depth++;
+                        else if (text[position] == ')' && --depth == 0)
+                            break;
+                    }
+                    if (position >= text.size())
+                        return nullptr;
+                    position++;
+
+                    auto node = std::make_unique<SplitNode>();
+                    node->kind = SplitNode::Kind::ATOM;
+                    node->text = text.substr(start, position - start);
+                    node->width = 0;
+                    return ParsePostfix(std::move(node));
+                }
+
+                position++;
+                std::vector<std::unique_ptr<SplitNode>> arguments;
+                if (!Accept(")"))
+                {
+                    while (true)
+                    {
+                        auto argument = ParseTernary();
+                        if (argument == nullptr || argument->width == 0)
+                            return nullptr;
+                        arguments.push_back(std::move(argument));
+                        if (Accept(")"))
+                            break;
+                        if (!Accept(","))
+                            return nullptr;
+                    }
+                }
+
+                auto node = std::make_unique<SplitNode>();
+                uint32_t constructorWidth = 0;
+                if (ParseType(name, constructorWidth))
+                {
+                    uint32_t total = 0;
+                    for (const auto& argument : arguments)
+                        total += argument->width;
+                    if (!(total == constructorWidth || (arguments.size() == 1 && arguments[0]->width == 1)))
+                        return nullptr;
+
+                    node->kind = SplitNode::Kind::CONSTRUCTOR;
+                    node->text = name;
+                    node->width = constructorWidth;
+                }
+                else if (IsComponentwise(name) || IsScalarResult(name))
+                {
+                    uint32_t width = 1;
+                    for (const auto& argument : arguments)
+                    {
+                        if (argument->width != 1)
+                        {
+                            if (width != 1 && width != argument->width)
+                                return nullptr;
+                            width = argument->width;
+                        }
+                    }
+
+                    node->kind = SplitNode::Kind::CALL;
+                    node->text = name;
+                    node->componentwise = IsComponentwise(name);
+                    node->width = node->componentwise ? width : 1;
+                }
+                else
+                {
+                    return nullptr;
+                }
+
+                node->children = std::move(arguments);
+                return ParsePostfix(std::move(node));
+            }
+
+            auto node = std::make_unique<SplitNode>();
+            node->kind = SplitNode::Kind::VARIABLE;
+            node->text = name;
+            node->width = VariableWidth(name);
+            return ParsePostfix(std::move(node));
+        }
+
+        std::unique_ptr<SplitNode> ParseUnary()
+        {
+            if (Accept("-"))
+            {
+                auto operand = ParseUnary();
+                if (operand == nullptr)
+                    return nullptr;
+                auto node = std::make_unique<SplitNode>();
+                node->kind = SplitNode::Kind::UNARY;
+                node->text = "-";
+                node->width = operand->width;
+                node->children.push_back(std::move(operand));
+                return node;
+            }
+            return ParsePrimary();
+        }
+
+        std::unique_ptr<SplitNode> Binary(std::string op, std::unique_ptr<SplitNode> left, std::unique_ptr<SplitNode> right)
+        {
+            if (left == nullptr || right == nullptr || left->width == 0 || right->width == 0)
+                return nullptr;
+            if (left->width != 1 && right->width != 1 && left->width != right->width)
+                return nullptr;
+
+            auto node = std::make_unique<SplitNode>();
+            node->kind = SplitNode::Kind::BINARY;
+            node->text = std::move(op);
+            node->width = std::max(left->width, right->width);
+            node->children.push_back(std::move(left));
+            node->children.push_back(std::move(right));
+            return node;
+        }
+
+        std::unique_ptr<SplitNode> ParseMultiplicative()
+        {
+            auto node = ParseUnary();
+            while (node != nullptr)
+            {
+                if (Accept("*"))
+                    node = Binary("*", std::move(node), ParseUnary());
+                else if (Accept("/"))
+                    node = Binary("/", std::move(node), ParseUnary());
+                else
+                    break;
+            }
+            return node;
+        }
+
+        std::unique_ptr<SplitNode> ParseAdditive()
+        {
+            auto node = ParseMultiplicative();
+            while (node != nullptr)
+            {
+                if (Accept("+"))
+                    node = Binary("+", std::move(node), ParseMultiplicative());
+                else if (Accept("-"))
+                    node = Binary("-", std::move(node), ParseMultiplicative());
+                else
+                    break;
+            }
+            return node;
+        }
+
+        std::unique_ptr<SplitNode> ParseComparison()
+        {
+            auto node = ParseAdditive();
+            if (node == nullptr)
+                return nullptr;
+
+            static constexpr std::string_view OPERATORS[] = { ">=", "<=", "==", "!=", ">", "<" };
+            for (auto op : OPERATORS)
+            {
+                if (Accept(op))
+                    return Binary(std::string(op), std::move(node), ParseAdditive());
+            }
+            return node;
+        }
+
+        std::unique_ptr<SplitNode> ParseTernary()
+        {
+            auto condition = ParseComparison();
+            if (condition == nullptr || !Accept("?"))
+                return condition;
+
+            auto whenTrue = ParseTernary();
+            if (whenTrue == nullptr || !Accept(":"))
+                return nullptr;
+            auto whenFalse = ParseTernary();
+            if (whenFalse == nullptr || condition->width == 0 || whenTrue->width == 0 || whenFalse->width == 0)
+                return nullptr;
+
+            const uint32_t width = std::max({ condition->width, whenTrue->width, whenFalse->width });
+            for (uint32_t w : { condition->width, whenTrue->width, whenFalse->width })
+            {
+                if (w != 1 && w != width)
+                    return nullptr;
+            }
+
+            auto node = std::make_unique<SplitNode>();
+            node->kind = SplitNode::Kind::TERNARY;
+            node->width = width;
+            node->children.push_back(std::move(condition));
+            node->children.push_back(std::move(whenTrue));
+            node->children.push_back(std::move(whenFalse));
+            return node;
+        }
+    };
+
+    // Whether a scalar sub-expression HLSL broadcasts to several components would be written once per component:
+    // only numbers and plain variables may be (a computed one would run once per component, and the driver could
+    // then fuse each copy with its own consumer, which it cannot do with one value used several times).
+    bool SplitBroadcastsOnlySimple(const SplitNode& node)
+    {
+        // The arguments of floatN(a, b, ...) each make components of their own: none is broadcast.
+        const bool broadcasts = node.width > 1 && !(node.kind == SplitNode::Kind::CONSTRUCTOR && node.children.size() > 1);
+        for (const auto& child : node.children)
+        {
+            if (broadcasts && child->width == 1 && child->kind != SplitNode::Kind::NUMBER &&
+                child->kind != SplitNode::Kind::VARIABLE && child->kind != SplitNode::Kind::ATOM)
+            {
+                return false;
+            }
+            if (!SplitBroadcastsOnlySimple(*child))
+                return false;
+        }
+
+        // A call with a scalar result under a node of several components is broadcast too.
+        return node.kind != SplitNode::Kind::CALL || node.componentwise || node.width == 1;
+    }
+
+    // The whole expression again (all its components), each operator parenthesised as parsed.
+    std::string SplitWhole(const SplitNode& node)
+    {
+        switch (node.kind)
+        {
+        case SplitNode::Kind::NUMBER:
+            return node.text;
+
+        case SplitNode::Kind::VARIABLE:
+        case SplitNode::Kind::ATOM:
+            return node.swizzle.empty() ? node.text : node.text + "." + node.swizzle;
+
+        case SplitNode::Kind::SWIZZLE:
+            return "(" + SplitWhole(*node.children[0]) + ")." + node.swizzle;
+
+        case SplitNode::Kind::CAST:
+            return "(" + node.text + ")(" + SplitWhole(*node.children[0]) + ")";
+
+        case SplitNode::Kind::UNARY:
+            return "(" + node.text + SplitWhole(*node.children[0]) + ")";
+
+        case SplitNode::Kind::BINARY:
+            return "(" + SplitWhole(*node.children[0]) + " " + node.text + " " + SplitWhole(*node.children[1]) + ")";
+
+        case SplitNode::Kind::TERNARY:
+            return "(" + SplitWhole(*node.children[0]) + " ? " + SplitWhole(*node.children[1]) + " : " + SplitWhole(*node.children[2]) + ")";
+
+        case SplitNode::Kind::CONSTRUCTOR:
+        case SplitNode::Kind::CALL:
+        {
+            std::string result = node.text + "(";
+            for (size_t k = 0; k < node.children.size(); k++)
+                result += (k != 0 ? ", " : "") + SplitWhole(*node.children[k]);
+            return result + ")";
+        }
+        }
+
+        return std::string();
+    }
+
+    // Component `index` of the expression, as an expression of its own that computes the same value with the same
+    // operations in the same order (each operator parenthesised as parsed).
+    std::string SplitComponent(const SplitNode& node, uint32_t index)
+    {
+        static constexpr char COMPONENTS[] = "xyzw";
+        const uint32_t i = node.width == 1 ? 0 : index;
+        switch (node.kind)
+        {
+        case SplitNode::Kind::NUMBER:
+            return node.text;
+
+        case SplitNode::Kind::VARIABLE:
+        case SplitNode::Kind::ATOM:
+            if (!node.swizzle.empty())
+                return node.text + "." + node.swizzle[node.swizzle.size() == 1 ? 0 : i];
+            return node.width == 1 ? node.text : node.text + "." + COMPONENTS[i];
+
+        case SplitNode::Kind::SWIZZLE:
+        {
+            const char c = node.swizzle[node.swizzle.size() == 1 ? 0 : i];
+            const uint32_t inner = c == 'x' ? 0 : c == 'y' ? 1 : c == 'z' ? 2 : 3;
+            return SplitComponent(*node.children[0], inner);
+        }
+
+        case SplitNode::Kind::CAST:
+            // Component i of the operand (the first components when it has more, all of a scalar), converted to
+            // the scalar type as the cast converts each component.
+            return "(" + node.text.substr(0, node.text.find_first_of("1234")) + ")(" + SplitComponent(*node.children[0], i) + ")";
+
+        case SplitNode::Kind::CONSTRUCTOR:
+        {
+            if (node.children.size() == 1 && node.children[0]->width == 1)
+                return "(" + node.text.substr(0, node.text.find_first_of("1234")) + ")(" + SplitComponent(*node.children[0], 0) + ")";
+
+            uint32_t offset = 0;
+            for (const auto& child : node.children)
+            {
+                if (i < offset + child->width)
+                    return SplitComponent(*child, i - offset);
+                offset += child->width;
+            }
+            return std::string();
+        }
+
+        case SplitNode::Kind::UNARY:
+            return "(" + node.text + SplitComponent(*node.children[0], i) + ")";
+
+        case SplitNode::Kind::BINARY:
+            return "(" + SplitComponent(*node.children[0], i) + " " + node.text + " " + SplitComponent(*node.children[1], i) + ")";
+
+        case SplitNode::Kind::TERNARY:
+            return "(" + SplitComponent(*node.children[0], i) + " ? " + SplitComponent(*node.children[1], i) + " : " +
+                SplitComponent(*node.children[2], i) + ")";
+
+        case SplitNode::Kind::CALL:
+        {
+            // A call with a scalar result (dot...) is written whole.
+            if (!node.componentwise)
+                return SplitWhole(node);
+
+            std::string result = node.text + "(";
+            for (size_t k = 0; k < node.children.size(); k++)
+            {
+                if (k != 0)
+                    result += ", ";
+                result += SplitComponent(*node.children[k], i);
+            }
+            return result + ")";
+        }
+        }
+
+        return std::string();
+    }
+
+    // Gives every value a temporary register (rN) or the scalar result (ps) receives in the statements before the
+    // early-out a name of its own (_tN, written once), so that reusing a register no longer ties a statement to the
+    // ones that write that register before or after it: what is left is the real flow of values. A statement that
+    // is not a single plain assignment reads and writes the registers themselves; the values it may read or write
+    // are copied back into them first (copy units, which the sinking moves like any other). The renamed statements
+    // compute exactly what they did: same operations, same operands.
+    class SinkRenamer
+    {
+    public:
+        std::vector<std::string> declarations;
+
+        static bool Renamable(const std::string& name)
+        {
+            return name == "ps" || (name.size() > 1 && name[0] == 'r' && isdigit(uint8_t(name[1])));
+        }
+
+        // The components a reference names: its swizzle, or the whole register (ps is a scalar).
+        static std::string Components(const std::string& name, const std::string& swizzle)
+        {
+            if (!swizzle.empty())
+                return swizzle;
+            return name == "ps" ? "x" : "xyzw";
+        }
+
+        static std::string Original(const std::string& name, char component)
+        {
+            return name == "ps" ? name : name + "." + component;
+        }
+
+        std::string RewriteReads(const std::string& text) const
+        {
+            static const std::regex REFERENCE(R"(\b(r\d+|ps)\b(?:\.([xyzw]{1,4})\b)?)");
+
+            std::string result;
+            size_t last = 0;
+            for (auto it = std::sregex_iterator(text.begin(), text.end(), REFERENCE); it != std::sregex_iterator(); ++it)
+            {
+                const auto& match = *it;
+                const std::string name = match[1].str();
+                const std::string components = Components(name, match[2].matched ? match[2].str() : std::string());
+
+                bool renamed = false;
+                std::vector<std::string> names;
+                for (char component : components)
+                {
+                    auto found = current.find({ name, component });
+                    if (found != current.end())
+                    {
+                        renamed = true;
+                        names.push_back(found->second);
+                    }
+                    else
+                    {
+                        names.push_back(Original(name, component));
+                    }
+                }
+
+                result.append(text, last, size_t(match.position(0)) - last);
+                if (!renamed)
+                {
+                    result += match.str(0);
+                }
+                else if (names.size() == 1)
+                {
+                    result += names[0];
+                }
+                else
+                {
+                    result += fmt::format("float{}(", names.size());
+                    for (size_t i = 0; i < names.size(); i++)
+                    {
+                        if (i != 0)
+                            result += ", ";
+                        result += names[i];
+                    }
+                    result += ')';
+                }
+
+                last = size_t(match.position(0) + match.length(0));
+            }
+
+            result.append(text, last, std::string::npos);
+            return result;
+        }
+
+        // A single plain assignment "dst[.mask] = expression;" on one line, rewritten; false for anything else.
+        bool RewriteStatement(std::string& line)
+        {
+            static const std::regex STATEMENT(R"(^(\s*)(r\d+|oC[0-3]|oDepth|ps|p0)(?:\.([xyzw]{1,4}))?\s*=(?!=)\s*(.*);\s*$)");
+
+            if (line.find('{') != std::string::npos || line.find('}') != std::string::npos || line.find('#') != std::string::npos)
+                return false;
+
+            std::smatch match;
+            if (!std::regex_match(line, match, STATEMENT))
+                return false;
+
+            const std::string indentation = match[1].str();
+            const std::string destination = match[2].str();
+            const std::string swizzle = match[3].matched ? match[3].str() : std::string();
+            const std::string expression = RewriteReads(match[4].str());
+
+            if (!Renamable(destination))
+            {
+                line = indentation + destination + (swizzle.empty() ? "" : "." + swizzle) + " = " + expression + ";";
+                return true;
+            }
+
+            const std::string components = Components(destination, swizzle);
+            const std::string temporary = fmt::format("_t{}", next++);
+            declarations.push_back(fmt::format("\t{} {} = 0.0;",
+                components.size() == 1 ? std::string("float") : fmt::format("float{}", components.size()), temporary));
+            widths[temporary] = uint32_t(components.size());
+
+            line = indentation + temporary + " = " + expression + ";";
+
+            for (size_t i = 0; i < components.size(); i++)
+            {
+                current[{ destination, components[i] }] = components.size() == 1 ? temporary :
+                    fmt::format("{}.{}", temporary, "xyzw"[i]);
+            }
+
+            return true;
+        }
+
+        // A statement RewriteStatement made ("_tN = expression;" with _tN of several components, or a write of
+        // oC0 with w and other components) as one statement per component ("_tN.x = ...;", "oC0.x = ...;"), in the
+        // original order, when the expression is component-wise (SplitParser): each component is then a statement
+        // of its own, which moves or stays by what reads that component alone. The final "oC0.xyzw = ..." no
+        // longer keeps the colour (and all it reads) before the alpha test with the alpha. Each component is
+        // computed with the same operations on the same operands as before. Empty: not split.
+        std::vector<std::string> SplitComponents(const std::string& line) const
+        {
+            static const std::regex TEMPORARY(R"(^(\s*)(_t\d+) = (.*);$)");
+            static const std::regex COLOUR(R"(^(\s*)(oC0)\.([xyzw]{2,4}) = (.*);$)");
+
+            std::smatch match;
+            std::string indentation;
+            std::string destination;
+            std::string components;
+            std::string expression;
+            if (std::regex_match(line, match, TEMPORARY))
+            {
+                auto found = widths.find(match[2].str());
+                if (found == widths.end() || found->second < 2)
+                    return {};
+                indentation = match[1].str();
+                destination = match[2].str();
+                components = std::string("xyzw").substr(0, found->second);
+                expression = match[3].str();
+            }
+            else if (std::regex_match(line, match, COLOUR) && match[3].str().find('w') != std::string::npos)
+            {
+                indentation = match[1].str();
+                destination = match[2].str();
+                components = match[3].str();
+                expression = match[4].str();
+                // An output read by its own expression would read its new components.
+                if (expression.find("oC0") != std::string::npos)
+                    return {};
+            }
+            else
+            {
+                return {};
+            }
+
+            SplitParser parser(expression, widths);
+            auto tree = parser.Parse();
+            if (tree == nullptr || tree->width != components.size() || !SplitBroadcastsOnlySimple(*tree))
+                return {};
+
+            std::vector<std::string> parts;
+            for (uint32_t i = 0; i < components.size(); i++)
+            {
+                const std::string component = SplitComponent(*tree, i);
+                if (component.empty())
+                    return {};
+                parts.push_back(fmt::format("{}{}.{} = {};", indentation, destination, components[i], component));
+            }
+            return parts;
+        }
+
+        // The two halves of a split shadow filter (exactly one of them runs). Each half's plain one-component
+        // assignments to registers ("r10.y = gather0_1.y;", "r10.y = tfetch2DArray(...).x;") write temporaries of
+        // their own instead, the same ones in both halves, and every read in them is renamed: the filter no longer
+        // writes the registers, so a later statement that reuses one of them (or a copy back into it) no longer ties
+        // it to its place. False, with nothing changed, unless both halves write the same components, each once and
+        // in no other way, and read none of them.
+        bool RewriteConstruct(std::vector<std::string>& first, std::vector<std::string>& second)
+        {
+            static const std::regex ONE(R"(^(\s*)(r\d+)\.([xyzw])\s*=(?!=)\s*(.*);\s*$)");
+            static const std::regex REFERENCE(R"(\b(r\d+|ps)\b(?:\.([xyzw]{1,4})\b)?)");
+
+            using Component = std::pair<std::string, char>;
+            auto collect = [&](const std::vector<std::string>& lines, std::set<Component>& written)
+                {
+                    for (const auto& line : lines)
+                    {
+                        std::smatch match;
+                        if (std::regex_match(line, match, ONE))
+                        {
+                            if (!written.insert({ match[2].str(), match[3].str()[0] }).second)
+                                return false;
+                            continue;
+                        }
+
+                        // Any other write of a register, an output, p0 or a temporary.
+                        if (std::regex_search(line, assignment()))
+                            return false;
+                    }
+                    return true;
+                };
+
+            std::set<Component> writtenFirst;
+            std::set<Component> writtenSecond;
+            if (!collect(first, writtenFirst) || !collect(second, writtenSecond) || writtenFirst.empty() || writtenFirst != writtenSecond)
+                return false;
+
+            // No read of a component the filter writes (the right-hand sides and every other line).
+            auto readsWritten = [&](const std::vector<std::string>& lines)
+                {
+                    for (const auto& line : lines)
+                    {
+                        std::smatch match;
+                        const std::string text = std::regex_match(line, match, ONE) ? match[4].str() : line;
+                        for (auto it = std::sregex_iterator(text.begin(), text.end(), REFERENCE); it != std::sregex_iterator(); ++it)
+                        {
+                            const std::string name = (*it)[1].str();
+                            for (char component : Components(name, (*it)[2].matched ? (*it)[2].str() : std::string()))
+                            {
+                                if (writtenFirst.count({ name, component }) != 0)
+                                    return true;
+                            }
+                        }
+                    }
+                    return false;
+                };
+
+            if (readsWritten(first) || readsWritten(second))
+                return false;
+
+            std::map<Component, std::string> temporaries;
+            for (const auto& component : writtenFirst)
+            {
+                const std::string temporary = fmt::format("_t{}", next++);
+                declarations.push_back(fmt::format("\tfloat {} = 0.0;", temporary));
+                widths[temporary] = 1;
+                temporaries[component] = temporary;
+            }
+
+            auto rewrite = [&](std::vector<std::string>& lines)
+                {
+                    for (auto& line : lines)
+                    {
+                        std::smatch match;
+                        if (std::regex_match(line, match, ONE))
+                            line = match[1].str() + temporaries[{ match[2].str(), match[3].str()[0] }] + " = " + RewriteReads(match[4].str()) + ";";
+                        else
+                            line = RewriteReads(line);
+                    }
+                };
+
+            rewrite(first);
+            rewrite(second);
+
+            for (const auto& [component, temporary] : temporaries)
+                current[component] = temporary;
+
+            return true;
+        }
+
+        // Copies the renamed values of these components back into their registers, one statement per register.
+        std::vector<std::string> CopyBack(const ComponentSets& which)
+        {
+            std::vector<std::string> copies;
+            for (const auto& [name, mask] : which)
+            {
+                if (!Renamable(name))
+                    continue;
+
+                std::string components;
+                std::vector<std::string> names;
+                for (uint32_t i = 0; i < 4; i++)
+                {
+                    const char component = "xyzw"[i];
+                    if ((mask & (1u << i)) == 0 || (name == "ps" && i != 0))
+                        continue;
+
+                    auto found = current.find({ name, component });
+                    if (found == current.end())
+                        continue;
+
+                    components += component;
+                    names.push_back(found->second);
+                }
+
+                if (names.empty())
+                    continue;
+
+                if (name == "ps")
+                {
+                    copies.push_back(fmt::format("\tps = {};", names[0]));
+                }
+                else if (names.size() == 1)
+                {
+                    copies.push_back(fmt::format("\t{}.{} = {};", name, components, names[0]));
+                }
+                else
+                {
+                    std::string list;
+                    for (size_t i = 0; i < names.size(); i++)
+                        list += (i != 0 ? ", " : "") + names[i];
+                    copies.push_back(fmt::format("\t{}.{} = float{}({});", name, components, names.size(), list));
+                }
+            }
+            return copies;
+        }
+
+        // After a statement that may have written these components of the registers themselves.
+        void Forget(const ComponentSets& which)
+        {
+            for (const auto& [name, mask] : which)
+            {
+                for (uint32_t i = 0; i < 4; i++)
+                {
+                    if ((mask & (1u << i)) != 0)
+                        current.erase({ name, "xyzw"[i] });
+                }
+            }
+        }
+
+    private:
+        std::map<std::pair<std::string, char>, std::string> current;
+        std::map<std::string, uint32_t> widths; // components of each temporary
+        uint32_t next = 0;
+    };
+}
+
+// The alpha test discards a pixel after all its code has run. The sunk variant runs, before the early-out branch
+// (ALPHA_TEST_EARLY_OUT_BRANCH, the same comparisons as the alpha test and the blend skip), only the statements the
+// alpha needs and those that must run for every pixel of a 2x2 quad (fetches with an implicit level of detail,
+// derivatives); everything else runs inside the branch, skipped by the pixels the alpha test or the blend skip will
+// discard. This takes in the early-out region of rewriteAlphaTestEarlyOut (the arithmetic after the last write of the
+// alpha) and, through the analysis of UnleashedRecomp-NX's sinking, everything before it that only feeds the colour:
+//
+// - The values the statements compute are first given names of their own (SinkRenamer), so only the real flow of
+//   values ties statements together; multi-component statements are split per component where that computes the
+//   same, oC0's last write included (its colour then no longer stays with its alpha).
+// - A statement moves when nothing that stays after it reads what it writes, or writes what it reads or writes, and
+//   it does not write oC0.w (which the branch and the alpha test read). A discarded pixel reads nothing else after
+//   the branch; a kept one runs every moved statement, in the original order, after the kept ones.
+// - Shadow filters rewritten as gathers split in two statements that never both run: the point fetches stay, the
+//   gather (no level of detail) may move.
+//
+// The variant is a second copy of the code: "#ifdef __spirv__ [branch] if (UR_ALPHA_TEST_SINK) { variant } else {
+// #endif previous code #ifdef __spirv__ } #endif". Without the bit, and for D3D12 and Metal, the previous code runs
+// as it was. It is written only when it moves the gathers or at least 8 statements from before the last write of
+// the alpha (UnleashedRecomp-NX's threshold). checkAlphaTestSink (sink_check.cpp) then proves, independently of this
+// analysis, that the variant computes the same outputs; the shader keeps its text when the check cannot model it,
+// and a variant the check finds wrong also fails the generation (main.cpp).
+uint32_t ShaderRecompiler::sinkIntoAlphaTestEarlyOut(const std::string& source)
+{
+    if ((pixelShaderOutputs & PIXEL_SHADER_OUTPUT_COLOR0) == 0)
+        return 0;
+
+    const bool debug = getenv("XENOS_SINK_DEBUG") != nullptr;
+    auto skip = [&](std::string_view reason) -> uint32_t
+        {
+            if (debug)
+                sinkDebug += fmt::format("no sunk variant: {}\n", reason);
+            return 0;
+        };
+
+    const std::vector<std::string> lines = splitLines(source);
+
+    size_t bodyStart = SIZE_MAX;
+    for (size_t i = 0; i < lines.size(); i++)
+    {
+        if (lines[i] == "\tbool gatherMismatch = false;")
+        {
+            bodyStart = i + 1;
+            break;
+        }
+    }
+    if (bodyStart == SIZE_MAX)
+        return skip("no body marker");
+
+    // One exit, hence one alpha test, not nested in any block.
+    size_t testLine = SIZE_MAX;
+    for (size_t i = bodyStart; i < lines.size(); i++)
+    {
+        if (lines[i].find("clip(") != std::string::npos)
+        {
+            if (testLine != SIZE_MAX)
+                return skip("several exits");
+            testLine = i;
+        }
+    }
+    if (testLine == SIZE_MAX || lines[testLine] != "\t" + std::string(ALPHA_TEST_LINE))
+        return skip("no single top-level alpha test");
+
+    // The verification output stays after the branch, where it still shows on every pixel.
+    size_t bodyEnd = testLine;
+    if (bodyEnd >= 3 && lines[bodyEnd - 1] == "#endif" &&
+        lines[bodyEnd - 2].find("gatherMismatch") != std::string::npos && lines[bodyEnd - 3] == "#ifdef __spirv__")
+    {
+        bodyEnd -= 3;
+    }
+
+    // The last write of oC0.w (the same recognition as rewriteAlphaTestEarlyOut): the statements after it are the
+    // early-out region; "extra" statements are those before it.
+    size_t alphaLine = SIZE_MAX;
+    for (size_t i = bodyEnd; i-- > bodyStart;)
+    {
+        if (lines[i].find("output.") != std::string::npos)
+            return skip("output. in the code");
+        const int write = colourWrite(lines[i]);
+        if (write < 0)
+            return skip("unrecognised mention of oC0");
+        if (write == 2)
+        {
+            alphaLine = i;
+            break;
+        }
+    }
+    if (alphaLine == SIZE_MAX)
+        return skip("no write of oC0.w");
+
+    // Alpha 1 (Marathon's vector/scalar export overlap): the early-out would never skip a pixel.
+    static const std::regex CONSTANT_ALPHA(R"(^\toC0\.w = ([0-9]+\.[0-9]+);$)");
+    std::smatch constantAlpha;
+    if (std::regex_match(lines[alphaLine], constantAlpha, CONSTANT_ALPHA) && std::stod(constantAlpha[1].str()) >= 1.0)
+        return skip("constant alpha 1");
+
+    // "}<tab>statement;" (the end of an if/else the translator prints on the line of the next statement) becomes two
+    // lines, so that the statement is a unit of its own. body[i] came from lines[bodyLine[i]].
+    std::vector<std::string> body;
+    std::vector<size_t> bodyLine;
+    for (size_t i = bodyStart; i < bodyEnd; i++)
+    {
+        const std::string text = trimmed(lines[i]);
+        if (text.size() > 1 && text[0] == '}')
+        {
+            const std::string rest = trimmed(text.substr(1));
+            if (!rest.empty() && rest.rfind("else", 0) != 0)
+            {
+                body.push_back("\t}");
+                bodyLine.push_back(i);
+                body.push_back("\t" + rest);
+                bodyLine.push_back(i);
+                continue;
+            }
+        }
+        body.push_back(lines[i]);
+        bodyLine.push_back(i);
+    }
+
+    // The statements, each with its braces and preprocessor lines.
+    std::vector<SinkUnit> units;
+    std::vector<std::vector<std::string>> constructs;
+    for (size_t i = 0; i < body.size();)
+    {
+        if (trimmed(body[i]).empty())
+        {
+            i++;
+            continue;
+        }
+
+        const size_t origin = bodyLine[i];
+        std::vector<std::string> unitLines;
+        int braces = 0;
+        int preprocessor = 0;
+        while (true)
+        {
+            if (i >= body.size())
+                return skip("unbalanced statement");
+
+            const std::string text = trimmed(body[i]);
+            if (text.rfind("#if", 0) == 0)
+                preprocessor++;
+            else if (text.rfind("#endif", 0) == 0)
+                preprocessor--;
+            for (char c : body[i])
+            {
+                if (c == '{')
+                    braces++;
+                else if (c == '}')
+                    braces--;
+            }
+
+            unitLines.push_back(body[i]);
+            i++;
+
+            if (braces == 0 && preprocessor == 0 && !text.empty() && (text.back() == ';' || text.back() == '}'))
+            {
+                const bool continues = i < body.size() && trimmed(body[i]).rfind("else", 0) == 0;
+                if (!continues)
+                    break;
+            }
+        }
+
+        // A shadow filter rewritten as a gather (rewriteShadowFetches):
+        //     #ifdef __spirv__ / [branch] if (C) / { gather } / else / #endif / { point fetches }
+        // becomes two statements that never both run: the point fetches under !(C), which stay (implicit level of
+        // detail), then the gather under C, which may move.
+        static constexpr std::string_view GATHER_IF = "\t[branch] if ((g_SpecConstants() & SPEC_CONSTANT_SHADOW_GATHER) != 0";
+        if (unitLines.size() > 6 && trimmed(unitLines[0]) == "#ifdef __spirv__" && unitLines[1].rfind(GATHER_IF, 0) == 0)
+        {
+            size_t elseLine = SIZE_MAX;
+            for (size_t l = 2; l < unitLines.size(); l++)
+            {
+                if (trimmed(unitLines[l]) == "else")
+                {
+                    elseLine = l;
+                    break;
+                }
+            }
+
+            if (elseLine != SIZE_MAX && elseLine + 2 < unitLines.size() && trimmed(unitLines[elseLine + 1]) == "#endif")
+            {
+                const std::string condition = unitLines[1].substr(std::string_view("\t[branch] if ").size());
+
+                SinkUnit fallback;
+                fallback.construct = constructs.size();
+                fallback.origin = origin;
+                fallback.lines.push_back("#ifdef __spirv__");
+                fallback.lines.push_back("\t[branch] if (!" + condition + ")");
+                fallback.lines.push_back("#endif");
+                fallback.lines.insert(fallback.lines.end(), unitLines.begin() + elseLine + 2, unitLines.end());
+
+                SinkUnit gathers;
+                gathers.construct = constructs.size();
+                gathers.origin = origin;
+                gathers.gatherPath = true;
+                gathers.lines.push_back("#ifdef __spirv__");
+                gathers.lines.insert(gathers.lines.end(), unitLines.begin() + 1, unitLines.begin() + elseLine);
+                gathers.lines.push_back("#endif");
+
+                constructs.push_back(unitLines);
+                units.push_back(std::move(fallback));
+                units.push_back(std::move(gathers));
+                continue;
+            }
+        }
+
+        SinkUnit unit;
+        unit.origin = origin;
+        unit.lines = std::move(unitLines);
+        units.push_back(std::move(unit));
+    }
+
+    // Renaming. What the code after the branch reads of the registers is copied back at the end (nothing today:
+    // the alpha test, the blend skip and the output read only oC0).
+    SinkRenamer renamer;
+    std::vector<SinkUnit> renamed;
+    renamed.reserve(units.size() * 2);
+
+    auto pushCopies = [&](const ComponentSets& which, size_t origin)
+        {
+            for (auto& copy : renamer.CopyBack(which))
+            {
+                SinkUnit unit;
+                unit.copy = true;
+                unit.origin = origin;
+                unit.lines.push_back(std::move(copy));
+                renamed.push_back(std::move(unit));
+            }
+        };
+
+    for (size_t i = 0; i < units.size(); i++)
+    {
+        SinkUnit& unit = units[i];
+
+        if (unit.construct == SIZE_MAX && unit.lines.size() == 1 && renamer.RewriteStatement(unit.lines[0]))
+        {
+            // One statement per component where the expression allows (SplitComponents).
+            std::vector<std::string> parts = renamer.SplitComponents(unit.lines[0]);
+            if (parts.empty())
+            {
+                renamed.push_back(std::move(unit));
+            }
+            else
+            {
+                for (auto& part : parts)
+                {
+                    SinkUnit component;
+                    component.origin = unit.origin;
+                    component.lines.push_back(std::move(part));
+                    renamed.push_back(std::move(component));
+                }
+            }
+            continue;
+        }
+
+        // Both halves of a shadow filter together.
+        const size_t count = (unit.construct != SIZE_MAX && i + 1 < units.size() && units[i + 1].construct == unit.construct) ? 2 : 1;
+        if (count == 2 && renamer.RewriteConstruct(units[i].lines, units[i + 1].lines))
+        {
+            renamed.push_back(std::move(units[i]));
+            renamed.push_back(std::move(units[i + 1]));
+            i++;
+            continue;
+        }
+
+        // Read and written through the registers themselves: the values it reads or may write go back into them
+        // first.
+        ComponentSets touched;
+        ComponentSets written;
+        for (size_t k = i; k < i + count; k++)
+        {
+            SinkUnit analysed = units[k];
+            analyseUnit(analysed);
+            addComponents(touched, analysed.uses);
+            addComponents(touched, analysed.mayDefs);
+            addComponents(written, analysed.mayDefs);
+        }
+
+        pushCopies(touched, unit.origin);
+        for (size_t k = i; k < i + count; k++)
+            renamed.push_back(std::move(units[k]));
+        renamer.Forget(written);
+        i += count - 1;
+    }
+
+    {
+        SinkUnit rest;
+        rest.lines.assign(lines.begin() + bodyEnd, lines.end());
+        analyseUnit(rest);
+        pushCopies(rest.uses, bodyEnd);
+    }
+
+    for (auto& unit : renamed)
+        analyseUnit(unit);
+
+    // What the branch and the code after it need of the statements before it. A pixel that skips the branch is
+    // discarded: only its alpha matters (the branch's condition is the alpha test's and the blend skip's). A pixel
+    // that runs the branch runs every moved statement there, so for it everything after has the same values.
+    ComponentSets liveAfter;
+    liveAfter["oC0"] |= 0x8;
+
+    // Backward: a statement stays when it is pinned, needs its quad, or writes something read after it by code that
+    // stays. Then forward checks may keep more (a statement that stays after a moved one and writes what the moved
+    // one reads or writes, or reads what it writes); repeat until nothing changes.
+    std::vector<bool> kept(renamed.size(), false);
+    for (size_t i = 0; i < renamed.size(); i++)
+        kept[i] = renamed[i].pinned || renamed[i].derivatives;
+
+    for (bool changed = true; changed;)
+    {
+        changed = false;
+
+        ComponentSets live = liveAfter;
+        for (size_t i = renamed.size(); i-- > 0;)
+        {
+            if (!kept[i] && overlaps(renamed[i].mayDefs, live))
+            {
+                kept[i] = true;
+                changed = true;
+            }
+
+            if (kept[i])
+            {
+                removeComponents(live, renamed[i].mustDefs);
+                addComponents(live, renamed[i].uses);
+            }
+        }
+
+        for (size_t i = 0; i < renamed.size(); i++)
+        {
+            if (kept[i])
+                continue;
+
+            for (size_t k = i + 1; k < renamed.size(); k++)
+            {
+                // The two halves of one shadow filter never both run.
+                if (!kept[k] || (renamed[k].construct != SIZE_MAX && renamed[k].construct == renamed[i].construct))
+                    continue;
+
+                if (overlaps(renamed[k].mayDefs, renamed[i].uses) || overlaps(renamed[k].mayDefs, renamed[i].mayDefs) ||
+                    overlaps(renamed[k].uses, renamed[i].mayDefs))
+                {
+                    kept[i] = true;
+                    changed = true;
+                    break;
+                }
+            }
+        }
+    }
+
+    // XENOS_SINK_DEBUG: why each statement stays (the first kept statement after it that reads what it writes, or
+    // what else keeps it).
+    if (debug)
+    {
+        for (size_t i = 0; i < renamed.size(); i++)
+        {
+            std::string first = trimmed(renamed[i].lines.empty() ? std::string() : renamed[i].lines[0]);
+            if (renamed[i].lines.size() > 1)
+                first += fmt::format(" (+{} lines)", renamed[i].lines.size() - 1);
+            std::string reason;
+            if (!kept[i])
+                reason = "moved";
+            else if (renamed[i].pinned)
+                reason = "pinned";
+            else if (renamed[i].derivatives)
+                reason = "derivatives";
+            else
+            {
+                for (size_t k = i + 1; k < renamed.size() && reason.empty(); k++)
+                {
+                    if (kept[k] && overlaps(renamed[i].mayDefs, renamed[k].uses))
+                        reason = fmt::format("read by kept #{}", k);
+                }
+                if (reason.empty() && overlaps(renamed[i].mayDefs, liveAfter))
+                    reason = "the alpha";
+                for (size_t k = i + 1; k < renamed.size() && reason.empty(); k++)
+                {
+                    if (kept[k] && (overlaps(renamed[k].mayDefs, renamed[i].uses) || overlaps(renamed[k].mayDefs, renamed[i].mayDefs)))
+                        reason = fmt::format("overwritten by kept #{}", k);
+                }
+                if (reason.empty())
+                    reason = "?";
+            }
+            sinkDebug += fmt::format("#{} {}: {}\n", i, reason, first);
+        }
+    }
+
+    // Worth a second copy of the code only for the gathers or a real amount of arithmetic from before the last
+    // write of the alpha (copies back not counted; the region after it is what rewriteAlphaTestEarlyOut takes
+    // anyway): UnleashedRecomp-NX's threshold for sinking into the early-out.
+    std::set<size_t> movedOrigins;
+    std::set<size_t> extraOrigins;
+    bool movedGathers = false;
+    for (size_t i = 0; i < renamed.size(); i++)
+    {
+        if (kept[i] || renamed[i].copy)
+            continue;
+        movedOrigins.insert(renamed[i].origin);
+        if (renamed[i].origin < alphaLine)
+            extraOrigins.insert(renamed[i].origin);
+        movedGathers |= renamed[i].gatherPath;
+    }
+
+    if (!movedGathers && extraOrigins.size() < 8)
+        return skip(fmt::format("{} statements from before the alpha move, fewer than 8", extraOrigins.size()));
+
+    // The variant: the temporaries, the statements that stay, then the branch with the moved ones.
+    std::vector<std::string> variant(renamer.declarations.begin(), renamer.declarations.end());
+    for (size_t i = 0; i < renamed.size(); i++)
+    {
+        if (!kept[i])
+            continue;
+
+        const SinkUnit& unit = renamed[i];
+
+        // Both halves of a shadow filter kept: the construct again (one test of its condition).
+        //     #ifdef __spirv__ / [branch] if (!C) / #endif / { point fetches }     (i)
+        //     #ifdef __spirv__ / [branch] if (C) / { gather } / #endif             (i + 1)
+        if (unit.construct != SIZE_MAX && !unit.gatherPath && i + 1 < renamed.size() && kept[i + 1] &&
+            renamed[i + 1].construct == unit.construct && renamed[i + 1].gatherPath &&
+            unit.lines.size() > 3 && renamed[i + 1].lines.size() > 2)
+        {
+            const SinkUnit& gathers = renamed[i + 1];
+            variant.push_back("#ifdef __spirv__");
+            variant.insert(variant.end(), gathers.lines.begin() + 1, gathers.lines.end() - 1);
+            variant.push_back("\telse");
+            variant.push_back("#endif");
+            variant.insert(variant.end(), unit.lines.begin() + 3, unit.lines.end());
+            i++;
+            continue;
+        }
+
+        variant.insert(variant.end(), unit.lines.begin(), unit.lines.end());
+    }
+
+    variant.push_back(std::string(ALPHA_TEST_EARLY_OUT_BRANCH));
+    variant.push_back("\t{");
+    for (size_t i = 0; i < renamed.size(); i++)
+    {
+        if (!kept[i])
+            variant.insert(variant.end(), renamed[i].lines.begin(), renamed[i].lines.end());
+    }
+    variant.push_back("\t}");
+
+    // Around the previous code (out: the text of rewriteAlphaTestEarlyOut, or `source` where that was undone). Its
+    // header and tail are those of `source`; its body ends at the verification output or the alpha test.
+    const std::vector<std::string> previous = splitLines(out);
+    size_t previousBodyEnd = SIZE_MAX;
+    for (size_t i = bodyStart; i < previous.size(); i++)
+    {
+        if (previous[i] == "\t" + std::string(ALPHA_TEST_LINE))
+        {
+            previousBodyEnd = i;
+            break;
+        }
+    }
+    if (previousBodyEnd == SIZE_MAX || previous.size() - previousBodyEnd != lines.size() - testLine ||
+        !std::equal(lines.begin(), lines.begin() + bodyStart, previous.begin()))
+    {
+        return skip("the previous code has another header or tail");
+    }
+    previousBodyEnd -= testLine - bodyEnd;
+
+    std::vector<std::string> result(previous.begin(), previous.begin() + bodyStart);
+    result.push_back("#ifdef __spirv__");
+    result.push_back("\t[branch] if (UR_ALPHA_TEST_SINK)");
+    result.push_back("\t{");
+    result.insert(result.end(), variant.begin(), variant.end());
+    result.push_back("\t}");
+    result.push_back("\telse");
+    result.push_back("\t{");
+    result.push_back("#endif");
