+    std::vector<std::string> tokenTexts(std::string_view text)
+    {
+        std::vector<std::string> result;
+        for (auto& token : tokenize(text))
+        {
+            if (token.kind != Token::Kind::END)
+                result.push_back(token.text);
+        }
+        return result;
+    }
